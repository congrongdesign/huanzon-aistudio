# 扣子生产环境变量模板
# 注意：这里全部是占位符，不要把真实密钥写入源码或发到公开仓库。

# Runtime
COZE_PROJECT_ENV=PROD
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_COZE_CLOUD=1

# Optional document conversion tools
# 0 = faster deploy, PPTX/PDF conversion may require image ZIP upload fallback.
# 1 = try installing LibreOffice + Poppler into project tools via micromamba during build.
INSTALL_DOC_TOOLS=0

# Security
JWT_SECRET=replace-with-a-long-random-production-secret

# Database: Supabase / PostgreSQL
COZE_SUPABASE_URL=https://your-supabase-project.example.com
COZE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
COZE_SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Storage: Coze / S3 compatible object storage
# 如果扣子平台自动注入对象存储变量，可按平台实际变量为准。
COZE_BUCKET_ENDPOINT_URL=https://your-bucket-endpoint.example.com
COZE_BUCKET_NAME=your-bucket-name

# Image generation provider: grsai / OpenAI-compatible
GRS_BASE_URL=https://grsaiapi.com
GRS_API_KEY=replace-with-grsai-api-key

# Chat provider: OpenAI-compatible fallback
CHAT_BASE_URL=https://grsaiapi.com
CHAT_API_KEY=replace-with-chat-api-key
OPENAI_BASE_URL=https://grsaiapi.com
OPENAI_API_KEY=replace-with-openai-compatible-api-key

# Optional: Codia capabilities
CODIA_BASE_URL=https://api.codia.ai
CODIA_API_KEY=replace-with-codia-api-key-if-needed

# Backend mode
# 云端建议强制走 Supabase，避免误用桌面/本地 JSON 后端。
LOCAL_BACKEND=0
HZ_BACKEND_MODE=supabase

# Optional: PPT import system tools
# 扣子云端通常不保证存在这些二进制；没有时 PPT 导入部分能力会降级或不可用。
# LIBREOFFICE_PATH=/usr/bin/libreoffice
# PDFTOPPM_PATH=/usr/bin/pdftoppm
