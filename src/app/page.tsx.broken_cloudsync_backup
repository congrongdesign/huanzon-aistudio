      setCanvasOffset({
        x: e.clientX - dragStart.x,
        y: e.clientY - dragStart.y,
      });
      return;
    }
    // Box selection
    if (isBoxSelecting && boxSelectStart) {
      const container = canvasContainerRef.current;
      if (container) {
        const rect = container.getBoundingClientRect();
        const x = (e.clientX - rect.left - canvasOffset.x) / canvasScale;
        const y = (e.clientY - rect.top - canvasOffset.y) / canvasScale;
        setBoxSelectEnd({ x, y });
      }
    }
  };

  const handleCanvasMouseUp = () => {
    // Finish box selection
    if (isBoxSelecting && boxSelectStart && boxSelectEnd) {
      const minX = Math.min(boxSelectStart.x, boxSelectEnd.x);
      const minY = Math.min(boxSelectStart.y, boxSelectEnd.y);
      const maxX = Math.max(boxSelectStart.x, boxSelectEnd.x);
      const maxY = Math.max(boxSelectStart.y, boxSelectEnd.y);
      // Only select if the box is at least 5px wide/tall
      if (maxX - minX > 5 || maxY - minY > 5) {
        const selected = canvasImages.filter((img) => {
          const display = getCanvasImageDisplaySize(img);
          const imgRight = img.canvas_x + display.w;
          const imgBottom = img.canvas_y + display.h;
          return img.canvas_x < maxX && imgRight > minX && img.canvas_y < maxY && imgBottom > minY;
        });
        if (selected.length > 0) {
          selectedImageIdsRef.current = selected.map((s) => s.id);
          selectedImageIdRef.current = selected[0].id;
          setSelectedImageIds(selected.map((s) => s.id));
          setSelectedImageId(selected[0].id);
