  // ─── Chat submit ───
  const handleChatSubmit = async () => {
    // Extract text from rich input (contentEditable div)
    const richEl = richInputRef.current;
    let inputText = "";
    let inputReferenceUrls: string[] = [];
    let richInstructionText = "";
    if (richEl) {
      const richParts = getRichInputParts(richEl);
      inputText = richParts.text;
      richInstructionText = richParts.instructionText;
      inputReferenceUrls = richParts.referenceUrls;
    } else {
      inputText = chatInput;
      richInstructionText = chatInput.trim();
    }
    const shouldCommitRefs = richInstructionText.length > 0;
    // Merge inline @mention images, uploaded references, and selected canvas images only after text is entered.
    const normalizedRefs = normalizeReferenceUrls(
      shouldCommitRefs
        ? (richEl
          ? inputReferenceUrls
          : [...referenceImages, ...inputReferenceUrls])
        : [],
    );
    const allRefImages = normalizedRefs.urls;
    if (normalizedRefs.ignored > 0) {
      setActionToast(`参考图最多使用 ${MAX_MODEL_REFERENCE_IMAGES} 张，已自动忽略多余图片`);
      setTimeout(() => setActionToast(null), 2400);
    }
    if (!richInstructionText && allRefImages.length === 0) return;

    const effectiveProjectId = await ensureProject();
    if (!effectiveProjectId) {
      setChatMessages((prev) => [
        ...prev,
        { id: `err-${Date.now()}`, project_id: null, role: "assistant", content: "没有项目，自动创建项目失败，请先登录或退出访客模式后重试", reference_image_urls: null, created_at: new Date().toISOString() },
      ]);
      return;
    }

    const userMsg: ChatMessage = {
      id: `local-${Date.now()}`,
      project_id: effectiveProjectId,
      role: "user",
      content: inputText,
      reference_image_urls: allRefImages.length > 0 ? JSON.stringify(allRefImages) : null,
      created_at: new Date().toISOString(),
    };
    setChatMessages((prev) => [...prev, userMsg]);
    setChatInput("");
    setReferenceImages([]);
    setInlineRefImages([]);
    setInlineRefCounter(0);
    setChatInputFocused(false);
    // Clear rich input
    if (richEl) richEl.innerHTML = "";

    try {
      let res: Response;
      // AbortController for the SSE stream (allows canceling ongoing generation)
      const chatAbortController = new AbortController();

      if (isGrsAiChatModel) {
        // ─── Unified agent-chat endpoint: backend manages memory + parses [GENERATE:xxx] + triggers generation ───
        const chatKey = chatApiKey?.trim() || apiKey?.trim();
        if (!chatKey) {
          throw new Error("使用对话模型需要先配置 API Key");
        }

        res = await fetch("/api/agent-chat", {
          method: "POST",
          headers: { "Content-Type": "application/json", ...getAuthHeaders() },
          body: JSON.stringify({
            message: inputText,
            projectId: effectiveProjectId,
            referenceImageUrls: allRefImages.length > 0 ? allRefImages : undefined,
            chatModel: actualChatModel,
            apiKey: chatKey,
            baseUrl: chatBaseUrl?.trim() || baseUrl?.trim() || undefined,
            imageModel,
            imageApiKey: apiKey?.trim() || undefined,
            imageBaseUrl: baseUrl?.trim() || undefined,
            imageAspectRatio: imageSize,       // aspect ratio e.g. "16:9"
            imagePixelSize: imageResolution,   // pixel size e.g. "1K"
            imageCount,
            agentMode: chatWorkMode === 'agent',
            canvasImages: chatWorkMode === 'agent'
              ? canvasImagesRef.current.slice(0, 40).map((img) => ({
                id: img.id,
                prompt: img.prompt,
                image_url: img.image_url,
                size: img.size,
                model: img.model,
                status: img.status,
              }))
              : undefined,
          }),
          signal: chatAbortController.signal,
        });
      } else {
        // ─── Legacy: coze/deepseek API (still uses /api/chat) ───
        const history = chatMessages.slice(-20).map((m) => ({
          role: m.role,
          content: m.content,
          ...(m.reference_image_urls ? { reference_image_urls: m.reference_image_urls } : {}),
        }));

        res = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json", ...getAuthHeaders() },
          body: JSON.stringify({
            message: inputText,
            history,
            projectId: effectiveProjectId,
            referenceImageUrls: allRefImages.length > 0 ? allRefImages : undefined,
            chatModel,
            dsApiKey: dsApiKey || undefined,
            dsBaseUrl: dsBaseUrl || undefined,
          }),
        });
      }

      if (!res.ok) {
        let errorDetail = "Chat request failed";
        try {
          const errData = await res.json();
          errorDetail = errData.error || errorDetail;
        } catch { /* use default */ }
        throw new Error(errorDetail);
      }
      if (!res.body) throw new Error("Chat response body is empty");

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let fullContent = "";
      let streamBuffer = "";
      const assistantId = `local-assistant-${Date.now()}`;
      setChatMessages((prev) => [
        ...prev,
        { id: assistantId, project_id: effectiveProjectId, role: "assistant", content: "", reference_image_urls: null, created_at: new Date().toISOString() },
      ]);

      // For legacy /api/chat: track [GENERATE:xxx] in frontend
      // (agent-chat handles generation on the backend, so no frontend parsing needed)
      const triggeredTags = new Set<string>();

      // Parse SSE events - supports both old format {content: "..."} and new format {type: "chunk", content: "..."}
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        streamBuffer += decoder.decode(value, { stream: true });
        const lines = streamBuffer.split("\n");
        streamBuffer = lines.pop() || "";

        for (const line of lines) {
          if (line.startsWith("data: ")) {
            const payload = line.slice(6);
            if (payload === "[DONE]") break;
            try {
              const parsed = JSON.parse(payload);

              // New agent-chat format with typed events
              if (parsed.type === "chunk" && parsed.content) {
                fullContent += parsed.content;
                setChatMessages((prev) =>
                  prev.map((m) =>
                    m.id === assistantId ? { ...m, content: fullContent } : m
                  )
                );
              } else if (parsed.type === "generate_start") {
                // Backend is generating an image — add placeholder to canvas
                const prompt = parsed.prompt as string;
                const genIndex = parsed.index as number ?? 0;
                console.log(`[generate_start] prompt="${prompt}", index=${genIndex}, imageSize="${imageSize}"`);
                const styleSuffix = STYLE_PRESETS.find((s) => s.value === stylePreset)?.suffix || "";
                const sizeStr = imageSize;
                const { w: displayW, h: displayH } = getAspectSize(sizeStr || "1:1");
                const placeholderId = `placeholder-gen${genIndex}-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;

                const placeholder: CanvasImage = {
                  id: placeholderId,
                  image_url: "",
                  image_key: "",
                  project_id: effectiveProjectId,
                  prompt,
                  canvas_x: 0,
                  canvas_y: 0,
                  canvas_width: displayW,
                  canvas_height: displayH,
                  size: sizeStr || "1:1",
                  model: imageModel,
                  status: "generating",
                  is_favorite: false,
                  isGenerating: true,
                  generateStartTime: Date.now(),
                  reference_images: allRefImages.length > 0 ? JSON.stringify(allRefImages) : null,
                  created_at: new Date().toISOString(),
                  updated_at: new Date().toISOString(),
                };

                // Calculate position
                const GAP = 16;
                const existingImages = canvasImagesRef.current;
                const clusterPos = getImageClusterPosition(displayW, displayH);
                let pos = { x: clusterPos.x, y: clusterPos.y };

                const generatingImgs = existingImages.filter((img) => img.isGenerating || img.isUploading);
                if (generatingImgs.length > 0) {
                  const rightmost = generatingImgs.reduce((max, img) => {
                    const right = img.canvas_x + img.canvas_width;
                    return right > max.right ? { x: img.canvas_x, y: img.canvas_y, right, bottom: img.canvas_y + img.canvas_height } : max;
                  }, { x: 0, y: 0, right: 0, bottom: 0 });
                  const tryX = rightmost.right + GAP;
                  const firstRowY = generatingImgs.reduce((minY, img) => Math.min(minY, img.canvas_y), Infinity);
                  const candidateY = isFinite(firstRowY) ? firstRowY : rightmost.y;
                  const vc = getViewportCenter();
                  const container = document.getElementById('canvas-container');
                  const viewW = container ? container.clientWidth : 1200;
                  const maxRight = vc.x + viewW / (2 * canvasScaleRef.current);
                  const overlaps = (tx: number, ty: number, imgs: CanvasImage[]) =>
                    imgs.some((img) =>
                      tx < img.canvas_x + img.canvas_width + GAP &&
                      tx + displayW + GAP > img.canvas_x &&
                      ty < img.canvas_y + img.canvas_height + GAP &&
                      ty + displayH + GAP > img.canvas_y
                    );
                  if (tryX + displayW <= maxRight && !overlaps(tryX, candidateY, existingImages)) {
                    pos = { x: tryX, y: candidateY };
                  } else {
                    const bottomY = generatingImgs.reduce((max, img) => Math.max(max, img.canvas_y + img.canvas_height), 0);
                    const newRowY = bottomY + GAP;
                    if (!overlaps(clusterPos.x, newRowY, existingImages)) {
                      pos = { x: clusterPos.x, y: newRowY };
                    }
                  }
                }
                placeholder.canvas_x = pos.x;
                placeholder.canvas_y = pos.y;

                setCanvasImages((prev) => [placeholder, ...prev]);
                canvasImagesRef.current = [placeholder, ...canvasImagesRef.current];

                // Associate the chat AbortController with this placeholder so cancelGeneration can abort it
                generateAbortControllers.current.set(placeholderId, chatAbortController);

                // Pan canvas to show placeholder
                const allGenerating = canvasImagesRef.current.filter((img) => img.isGenerating || img.isUploading);
                if (allGenerating.length > 1) {
                  const minX = allGenerating.reduce((m, img) => Math.min(m, img.canvas_x), Infinity);
                  const minY = allGenerating.reduce((m, img) => Math.min(m, img.canvas_y), Infinity);
                  const maxX = allGenerating.reduce((m, img) => Math.max(m, img.canvas_x + img.canvas_width), -Infinity);
                  const maxY = allGenerating.reduce((m, img) => Math.max(m, img.canvas_y + img.canvas_height), -Infinity);
                  panCanvasToPosition(minX, minY, maxX - minX, maxY - minY);
                } else {
                  panCanvasToPosition(pos.x, pos.y, displayW, displayH);
                }

              } else if (parsed.type === "generate_complete" && parsed.image) {
                // Backend completed image generation — replace placeholder with real image
                const img = parsed.image as CanvasImage;
                const genIndex = parsed.index as number ?? 0;

                // Find the placeholder for this generation by matching the generate index in the ID
                // Placeholder IDs are formatted as "placeholder-gen{index}-{timestamp}-{random}"
                const placeholderIdx = canvasImagesRef.current.findIndex(
                  (ci) => ci.isGenerating && ci.id.startsWith(`placeholder-gen${genIndex}-`)
                );
                console.log(`[generate_complete] img.prompt="${img.prompt}", index=${genIndex}, placeholderIdx=${placeholderIdx}, generatingCount=${canvasImagesRef.current.filter(ci => ci.isGenerating).length}`);

                if (placeholderIdx >= 0) {
                  // Replace placeholder, keeping its position and size
                  const placeholder = canvasImagesRef.current[placeholderIdx];
                  // Clean up AbortController for this placeholder
                  generateAbortControllers.current.delete(placeholder.id);
                  const canvasImage: CanvasImage = {
                    ...img,
                    canvas_x: placeholder.canvas_x,
                    canvas_y: placeholder.canvas_y,
                    canvas_width: placeholder.canvas_width,
                    canvas_height: placeholder.canvas_height,
                    isGenerating: false,
                  };

                  // Update canvas position in DB
                  fetch(`/api/history/${img.id}`, {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json", ...getAuthHeaders() },
                    body: JSON.stringify({
                      canvas_x: placeholder.canvas_x,
                      canvas_y: placeholder.canvas_y,
                      canvas_width: placeholder.canvas_width,
                      canvas_height: placeholder.canvas_height,
                    }),
                  }).catch(() => {});

                  setCanvasImages((prev) => prev.map((ci) => ci.id === placeholder.id ? canvasImage : ci));
                  canvasImagesRef.current = canvasImagesRef.current.map((ci) => ci.id === placeholder.id ? canvasImage : ci);
                } else {
                  // Fallback: try matching by prompt (for backward compatibility)
                  const fallbackIdx = canvasImagesRef.current.findIndex(
                    (ci) => ci.isGenerating && ci.prompt === img.prompt
                  );
                  if (fallbackIdx >= 0) {
                    const placeholder = canvasImagesRef.current[fallbackIdx];
                    // Clean up AbortController for this placeholder
                    generateAbortControllers.current.delete(placeholder.id);
                    const canvasImage: CanvasImage = {
                      ...img,
                      canvas_x: placeholder.canvas_x,
                      canvas_y: placeholder.canvas_y,
                      canvas_width: placeholder.canvas_width,
                      canvas_height: placeholder.canvas_height,
                      isGenerating: false,
                    };
                    fetch(`/api/history/${img.id}`, {
                      method: "PATCH",
                      headers: { "Content-Type": "application/json", ...getAuthHeaders() },
                      body: JSON.stringify({
                        canvas_x: placeholder.canvas_x,
                        canvas_y: placeholder.canvas_y,
                        canvas_width: placeholder.canvas_width,
                        canvas_height: placeholder.canvas_height,
                      }),
                    }).catch(() => {});
                    setCanvasImages((prev) => prev.map((ci) => ci.id === placeholder.id ? canvasImage : ci));
                    canvasImagesRef.current = canvasImagesRef.current.map((ci) => ci.id === placeholder.id ? canvasImage : ci);
                  } else {
                    // No matching placeholder found — add image with calculated position
                    const { w: displayW, h: displayH } = getAspectSize(img.size || "1:1");
                    const clusterPos = getImageClusterPosition(displayW, displayH);
                    const pos = findNonOverlappingPosition(clusterPos.x, clusterPos.y, displayW, displayH);
                    const canvasImage: CanvasImage = {
                      ...img,
                      canvas_x: pos.x,
                      canvas_y: pos.y,
                      canvas_width: displayW,
                      canvas_height: displayH,
                      isGenerating: false,
                    };

                    fetch(`/api/history/${img.id}`, {
                      method: "PATCH",
                      headers: { "Content-Type": "application/json", ...getAuthHeaders() },
                      body: JSON.stringify({ canvas_x: pos.x, canvas_y: pos.y, canvas_width: displayW, canvas_height: displayH }),
                    }).catch(() => {});

                    setCanvasImages((prev) => [canvasImage, ...prev]);
                    canvasImagesRef.current = [canvasImage, ...canvasImagesRef.current];
                  }
                }

              } else if (parsed.type === "generate_error") {
                // Image generation failed — mark placeholder as failed (show FailedPlaceholder)
                const genIndex = parsed.index as number ?? 0;
                const placeholderIdx = canvasImagesRef.current.findIndex(
                  (ci) => ci.isGenerating && ci.id.startsWith(`placeholder-gen${genIndex}-`)
                );
                if (placeholderIdx >= 0) {
                  const placeholder = canvasImagesRef.current[placeholderIdx];
                  // Clean up AbortController for this placeholder
                  generateAbortControllers.current.delete(placeholder.id);
                  const failedImg: CanvasImage = {
                    ...placeholder,
                    status: 'failed',
                    isGenerating: false,
                  };
                  setCanvasImages((prev) => prev.map((ci) => ci.id === placeholder.id ? failedImg : ci));
                  canvasImagesRef.current = canvasImagesRef.current.map((ci) => ci.id === placeholder.id ? failedImg : ci);
                } else {
                  // Fallback: remove by prompt
                  setCanvasImages((prev) => prev.filter((ci) => !(ci.isGenerating && ci.prompt === parsed.prompt)));
                  canvasImagesRef.current = canvasImagesRef.current.filter((ci) => !(ci.isGenerating && ci.prompt === parsed.prompt));
                }
                // 失败通过画布失败卡反馈，避免在聊天里堆叠错误文本噪音

              } else if (parsed.type === "error") {
                throw new Error(parsed.error);

              } else if (parsed.type === "done") {
                // Stream complete, nothing more to do
                break;

              } else if (parsed.content) {
                // Legacy /api/chat format — plain {content: "..."} without type
                fullContent += parsed.content;
                setChatMessages((prev) =>
                  prev.map((m) =>
                    m.id === assistantId ? { ...m, content: fullContent } : m
                  )
                );

                // Legacy: frontend parses [GENERATE:xxx] — ONLY for non-agent-chat routes
                // agent-chat handles generation on the backend, skip frontend parsing
                if (!isGrsAiChatModel) {
                  const generateRegex = /\[GENERATE:([^\]]+)\]/g;
                  let match;
                  while ((match = generateRegex.exec(fullContent)) !== null) {
                    const tag = match[1].trim();
                    if (!triggeredTags.has(tag)) {
                      triggeredTags.add(tag);
                      for (let i = 0; i < imageCount; i++) generateImage(tag);
                    }
                  }
                }
              }
            } catch {
              // skip
            }
          }
        }
      }
    } catch (err) {
      // Don't show error for user-initiated cancellation
      if (err instanceof DOMException && err.name === 'AbortError') {
        // Silently handle abort - placeholder cleanup is done by cancelGeneration
        return;
      }
      setChatMessages((prev) => [
        ...prev,
        { id: `err-${Date.now()}`, project_id: effectiveProjectId, role: "assistant", content: `对话失败: ${err instanceof Error ? err.message : "未知错误"}`, reference_image_urls: null, created_at: new Date().toISOString() },
      ]);
    }
    // No finally setIsGenerating(false) - generation tasks manage their own lifecycle
  };

  // ─── Direct generate (no chat) ───
  // ─── Optimize prompt (standalone feature) ───
  const optimizePrompt = async () => {
    if (!chatInput.trim()) return;
    setOptimizingPrompt(true);
    try {
      let res: Response;
        if (isGrsAiChatModel) {
          if (!chatApiKey && !apiKey && !isLocalApiEndpoint(chatBaseUrl || baseUrl)) throw new Error("使用 grsai 模型需要先配置 API Key");
          res = await fetch("/api/grsai-chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            messages: [
              { role: "system", content: "你是一个专业的AI图像生成提示词优化专家。将用户提供的简短描述，扩展为更加详细、精准、富有表现力的中文提示词。只返回优化后的中文提示词，不要加任何解释。" },
              { role: "user", content: chatInput },
            ],
            model: actualChatModel,
            stream: true,
              apiKey: chatApiKey?.trim() || apiKey?.trim() || (isLocalApiEndpoint(chatBaseUrl || baseUrl) ? "ollama" : undefined),
            baseUrl: chatBaseUrl?.trim() || baseUrl?.trim() || undefined,
          }),
        });
      } else {
        res = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json", ...getAuthHeaders() },
          body: JSON.stringify({
            message: chatInput,
            history: [],
            projectId: currentProjectId,
            optimize: true,
            chatModel,
            dsApiKey: dsApiKey || undefined,
            dsBaseUrl: dsBaseUrl || undefined,
          }),
        });
      }
      if (!res.ok) {
        let errorDetail = "优化失败";
        try { const errData = await res.json(); errorDetail = errData.error || errorDetail; } catch { /* use default */ }
        throw new Error(errorDetail);
      }
      if (!res.body) throw new Error("优化响应为空");
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let result = "";
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        const text = decoder.decode(value, { stream: true });
        for (const line of text.split("\n")) {
          if (line.startsWith("data: ")) {
            const payload = line.slice(6);
            if (payload === "[DONE]") break;
            try { const p = JSON.parse(payload); if (p.content) result += p.content; } catch { /* skip */ }
          }
        }
      }
      if (result) setChatInput(result.replace(/^\s+|\s+$/g, ""));
    } catch {
      /* skip */
    } finally {
      setOptimizingPrompt(false);
    }
  };

