        const rHist = new Float64Array(bins);
        const gHist = new Float64Array(bins);
        const bHist = new Float64Array(bins);
        const lumHist = new Float64Array(bins);

        // Color quantization for palette (median cut simplified: collect notable colors)
        const colorBuckets: Record<string, { r: number; g: number; b: number; count: number }> = {};

        for (let i = 0; i < data.length; i += 4) {
          const r = data[i], g = data[i + 1], b = data[i + 2];
          const rBin = Math.min(Math.floor(r / 4), bins - 1);
          const gBin = Math.min(Math.floor(g / 4), bins - 1);
