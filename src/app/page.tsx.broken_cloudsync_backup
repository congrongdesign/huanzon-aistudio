                              disabled={cloudSyncLoading}
                              className="rounded-lg bg-primary px-3 py-1.5 text-xs font-medium text-white transition hover:bg-primary/90 disabled:opacity-50"
                            >
                              恢复
                            </button>
                            <button
                              onClick={() => deleteCloudSyncEntry(entry)}
                              disabled={cloudSyncLoading}
                              className="rounded-lg border border-border px-3 py-1.5 text-xs text-muted-foreground transition hover:bg-muted hover:text-red-500 disabled:opacity-50"
                            >
                              删除
                            </button>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      )}

      {backupDialogProject && (
        <div className="fixed inset-0 z-[260] flex items-center justify-center bg-black/45 p-4 backdrop-blur-sm" onClick={() => setBackupDialogProject(null)}>
          <div className="w-full max-w-lg rounded-2xl border border-border bg-card p-5 shadow-2xl" onClick={(e) => e.stopPropagation()}>
            <div className="mb-4 flex items-start justify-between gap-3">
              <div>
                <h3 className="text-base font-semibold text-foreground">云盘 / NAS 备份</h3>
                <p className="mt-1 text-xs leading-relaxed text-muted-foreground">
                  当前可直接备份到本机目录或已挂载的 NAS 目录。
                </p>
              </div>
              <button onClick={() => setBackupDialogProject(null)} className="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground">
                <X className="h-4 w-4" />
              </button>
            </div>

            <div className="space-y-4">
              <div className="rounded-xl border border-border bg-muted/40 p-3">
                <div className="text-xs font-medium text-foreground">备份项目</div>
                <div className="mt-1 truncate text-sm text-primary">{backupDialogProject.name}</div>
                <div className="mt-2 text-[11px] leading-relaxed text-muted-foreground">
                  备份包会完整包含项目信息、对话记录、画布图片记录、参考图、提示词、技能和图片资源。
                </div>
              </div>

              <label className="block space-y-1.5">
                <span className="text-xs font-medium text-foreground">本地 / NAS 备份目录</span>
                <input
                  value={backupTargetPath}
                  onChange={(e) => setBackupTargetPath(e.target.value)}
                  placeholder="/Volumes/你的NAS/AIStudio备份 或 D:\\AIStudio备份"
                  className="w-full rounded-xl border border-border bg-background px-3 py-2 text-sm text-foreground outline-none transition focus:border-primary"
                />
                <span className="block text-[11px] leading-relaxed text-muted-foreground">
                  如果是 NAS，请先在系统里把 NAS 挂载成磁盘目录，然后把路径填到这里。
                </span>
              </label>

              <div className="grid grid-cols-2 gap-2">
                <button
                  disabled
                  className="rounded-xl border border-border bg-muted/40 px-3 py-2 text-left opacity-60"
                  title="需要百度开放平台授权后启用"
                >
                  <div className="text-xs font-medium text-foreground">百度网盘</div>
                  <div className="mt-1 text-[11px] text-muted-foreground">待接入授权</div>
                </button>
              </div>

              {backupMessage && (
                <div className="rounded-xl border border-border bg-muted/50 px-3 py-2 text-xs leading-relaxed text-muted-foreground">
                  {backupMessage}
                </div>
              )}

              <div className="flex gap-2">
                <button
                  onClick={() => exportProjectPackage(backupDialogProject)}
                  disabled={projectPackageBusy}
                  className="flex-1 rounded-xl border border-border bg-background px-3 py-2 text-sm font-medium text-foreground transition hover:bg-muted disabled:opacity-50"
                >
                  仅导出下载
                </button>
                <button
                  onClick={backupProjectPackage}
                  disabled={projectPackageBusy || !backupTargetPath.trim()}
                  className="flex-1 rounded-xl bg-primary px-3 py-2 text-sm font-medium text-white transition hover:bg-primary/90 disabled:opacity-50"
                >
                  {projectPackageBusy ? "处理中..." : "备份到目录"}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

    </div>
    </div>
  );
}
