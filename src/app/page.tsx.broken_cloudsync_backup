  // Helper: get display dimensions from aspect ratio string
  function getAspectSize(ratio: string): { w: number; h: number } {
    const map: Record<string, { w: number; h: number }> = {
      "1:1":   { w: 320, h: 320 },
      "16:9":  { w: 480, h: 270 },
      "9:16":  { w: 270, h: 480 },
      "4:3":   { w: 400, h: 300 },
      "3:4":   { w: 300, h: 400 },
      "3:2":   { w: 420, h: 280 },
      "2:3":   { w: 280, h: 420 },
      "5:4":   { w: 375, h: 300 },
      "4:5":   { w: 300, h: 375 },
      "21:9":  { w: 504, h: 216 },
      "9:21":  { w: 216, h: 504 },
      "2:1":   { w: 480, h: 240 },
      "1:2":   { w: 240, h: 480 },
      "1:4":   { w: 160, h: 640 },
      "4:1":   { w: 640, h: 160 },
      "1:8":   { w: 120, h: 960 },
      "8:1":   { w: 960, h: 120 },
    };
    if (map[ratio]) return map[ratio];
    // Try pixel format "1024x1024"
    if (ratio.includes("x")) {
      const [pw, ph] = ratio.split("x").map(Number);
      if (pw && ph) {
        const scale = 320 / Math.max(pw, ph);
        return { w: Math.round(pw * scale), h: Math.round(ph * scale) };
      }
    }
    return { w: 320, h: 320 };
  }

