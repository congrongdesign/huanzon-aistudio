          .sort((a, b) => b.count - a.count)
          .slice(0, 6)
          .map((c) => `#${c.r.toString(16).padStart(2, "0")}${c.g.toString(16).padStart(2, "0")}${c.b.toString(16).padStart(2, "0")}`);

        // Fallback: if all colors filtered out, take top 3 regardless
        if (palette.length < 3) {
          const fallback = Object.values(colorBuckets)
            .sort((a, b) => b.count - a.count)
            .slice(0, 6)
            .map((c) => `#${c.r.toString(16).padStart(2, "0")}${c.g.toString(16).padStart(2, "0")}${c.b.toString(16).padStart(2, "0")}`);
          fallback.forEach((c) => { if (!palette.includes(c)) palette.push(c); });
        }

        // Compute average hue
        let totalH = 0, hueCount = 0;
        for (let i = 0; i < data.length; i += 16) { // sample every 4th pixel
