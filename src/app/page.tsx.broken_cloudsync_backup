  // ─── Inpaint confirm: generate mask, sync to chat, and call /api/inpaint ───
  const confirmInpaint = useCallback(async () => {
    if (inpaintAutoSelecting) return;
    if (!inpaintMode) return;
    if (!inpaintSmartMaskBase64 && inpaintMode.strokes.length === 0) return;
    if (inpaintSmartMaskBase64 && !inpaintMaskHasSelection) return;

    const img = canvasImagesRef.current.find(i => i.id === inpaintMode.imageId);
    if (!img) return;

    if (!apiKey || !baseUrl) {
      alert('请先配置生图 API Key 和 Base URL');
      return;
    }

    // Get original image dimensions
    let origW = img.canvas_width;
    let origH = img.canvas_height;
    try {
      const meta = await new Promise<{ w: number; h: number }>((resolve) => {
        const i = new Image();
        i.onload = () => resolve({ w: i.naturalWidth, h: i.naturalHeight });
        i.onerror = () => resolve({ w: img.canvas_width, h: img.canvas_height });
        i.src = img.image_url;
      });
      origW = meta.w;
      origH = meta.h;
    } catch { /* use canvas dims */ }

    // Build final mask: prefer smart pixel mask, fallback to manual brush strokes.
    const canvas = inpaintCanvasRef.current;
    const canvasW = Math.max(1, canvas?.width || img.canvas_width);
    const canvasH = Math.max(1, canvas?.height || img.canvas_height);
    let maskBase64 = "";
    if (inpaintSmartMaskBase64) {
      const smartMask = await new Promise<HTMLImageElement>((resolve, reject) => {
        const image = new Image();
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error("智能蒙版解析失败"));
        image.src = inpaintSmartMaskBase64;
      });
      const maskCanvas = document.createElement("canvas");
      maskCanvas.width = origW;
      maskCanvas.height = origH;
      const mctx = maskCanvas.getContext("2d");
      if (!mctx) throw new Error("蒙版构建失败");
      mctx.fillStyle = "#ffffff";
      mctx.fillRect(0, 0, origW, origH);
      mctx.drawImage(smartMask, 0, 0, canvasW, canvasH, 0, 0, origW, origH);
      const imageData = mctx.getImageData(0, 0, origW, origH);
      const data = imageData.data;
      let active = 0;
      for (let i = 0; i < origW * origH; i++) {
        const pi = i * 4;
        const selected = data[pi + 3] > 0 && (data[pi] < 128 || data[pi + 1] < 128 || data[pi + 2] < 128);
        if (selected) {
          data[pi] = 0;
          data[pi + 1] = 0;
          data[pi + 2] = 0;
          data[pi + 3] = 255;
          active++;
        } else {
          data[pi] = 255;
          data[pi + 1] = 255;
          data[pi + 2] = 255;
          data[pi + 3] = 255;
        }
      }
      if (active === 0) throw new Error("未识别到可编辑区域");
      mctx.putImageData(imageData, 0, 0);
      maskBase64 = maskCanvas.toDataURL("image/png");
    } else {
      const scaleX = origW / canvasW;
      const scaleY = origH / canvasH;
      const scaledStrokes = inpaintMode.strokes.map(stroke =>
        stroke.map(p => ({ x: Math.round(p.x * scaleX), y: Math.round(p.y * scaleY) }))
      );
      const scaledBrushSize = Math.round(inpaintMode.brushSize * Math.max(scaleX, scaleY));
      maskBase64 = generateInpaintMask(origW, origH, scaledStrokes, scaledBrushSize);
    }

    // Prompt from inpaint mode or fallback
    const prompt = inpaintMode.prompt || 'reimagine this area creatively';
    const displayPrompt = `局部重绘: ${prompt}`;

    // Sync to chat: add user message
    const userMsg: ChatMessage = {
      id: `local-inpaint-user-${Date.now()}`,
      project_id: currentProjectId,
      role: "user",
      content: displayPrompt,
      reference_image_urls: JSON.stringify([img.image_url]),
      created_at: new Date().toISOString(),
    };
    setChatMessages(prev => [...prev, userMsg]);

    // Add assistant placeholder message
    const assistantId = `local-inpaint-assistant-${Date.now()}`;
    setChatMessages(prev => [
      ...prev,
      { id: assistantId, project_id: currentProjectId, role: "assistant", content: "正在重绘选中区域...", reference_image_urls: null, created_at: new Date().toISOString() },
    ]);

    // Open chat panel if collapsed
    setChatPanelOpen(true);

    pushUndo();

    // Add placeholder on canvas
    const placeholder: CanvasImage = {
      id: `inpaint-${Date.now()}`,
      image_url: '',
      image_key: '',
      project_id: img.project_id,
      prompt: displayPrompt,
      canvas_x: img.canvas_x + img.canvas_width + 20,
      canvas_y: img.canvas_y,
      canvas_width: img.canvas_width,
      canvas_height: img.canvas_height,
      size: img.size,
      model: img.model,
      status: 'pending',
      is_favorite: false,
      reference_images: '',
      isGenerating: true,
      generateStartTime: Date.now(),
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    };
    setCanvasImages([placeholder, ...canvasImagesRef.current]);
    canvasImagesRef.current = [placeholder, ...canvasImagesRef.current];

    try {
      const res = await fetch('/api/inpaint', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...getAuthHeaders() },
        body: JSON.stringify({
          imageId: img.id,
          imageUrl: img.image_url,
          maskBase64,
          prompt,
          model: img.model || 'gpt-image-2',
          apiKey,
          baseUrl,
          origWidth: origW,
          origHeight: origH,
        }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: '局部重绘失败' }));
        throw new Error(err.error || '局部重绘失败');
      }

      const data = await res.json();
      // API returns { success: true, record: {...} } or { imageUrl: ... }
      const record = data.record;
      if (!record && !data.imageUrl) throw new Error('未返回图片');

      // Build result from record or fallback
      const result: CanvasImage = record ? {
        id: record.id,
        image_url: record.image_url,
        image_key: record.image_key || '',
        project_id: record.project_id || img.project_id,
        prompt: record.prompt || displayPrompt,
        canvas_x: record.canvas_x ?? placeholder.canvas_x,
        canvas_y: record.canvas_y ?? placeholder.canvas_y,
        canvas_width: record.canvas_width ?? placeholder.canvas_width,
        canvas_height: record.canvas_height ?? placeholder.canvas_height,
        size: record.size || img.size,
        model: record.model || img.model,
        status: 'completed',
        is_favorite: record.is_favorite ?? false,
        reference_images: '',
        isGenerating: false,
        created_at: record.created_at || new Date().toISOString(),
        updated_at: record.updated_at || new Date().toISOString(),
      } : {
        ...placeholder,
        image_url: data.imageUrl,
        image_key: data.imageKey || '',
        status: 'completed',
        isGenerating: false,
        updated_at: new Date().toISOString(),
      };

      setCanvasImages(prev => prev.map(i => i.id === placeholder.id ? result : i));
      canvasImagesRef.current = canvasImagesRef.current.map(i => i.id === placeholder.id ? result : i);

      // Update assistant message with result
      setChatMessages(prev => prev.map(m =>
        m.id === assistantId
          ? { ...m, content: `已完成局部重绘: ${prompt}`, image_url: result.image_url }
          : m
      ));

      if (assetHistoryOpen && (assetHistory?.imageId === img.id || assetHistory?.imageId === result.id)) {
        await loadAssetHistory(assetHistory.imageId === result.id ? result : img);
      }

    } catch (err: unknown) {
      const errorMsg = err instanceof Error ? err.message : '局部重绘失败';
      // Remove placeholder on error
      setCanvasImages(prev => prev.filter(i => i.id !== placeholder.id));
      canvasImagesRef.current = canvasImagesRef.current.filter(i => i.id !== placeholder.id);
      // Update assistant message with error
      setChatMessages(prev => prev.map(m =>
        m.id === assistantId
          ? { ...m, content: `局部重绘失败: ${errorMsg}` }
          : m
      ));
      console.error('Inpaint error:', errorMsg);
    }

    cancelInpaint();
  }, [inpaintMode, inpaintSmartMaskBase64, inpaintMaskHasSelection, apiKey, baseUrl, currentProjectId, assetHistoryOpen, assetHistory?.imageId, loadAssetHistory, inpaintAutoSelecting, generateInpaintMask]);

  // ─── Image generation (concurrent-safe) ───
  const generateImage = async (prompt: string, options: GenerateImageOptions = {}) => {
    if (!apiKey && !isLocalApiEndpoint(baseUrl)) {
      setChatMessages((prev) => [
        ...prev,
        { id: `err-${Date.now()}`, project_id: currentProjectIdRef.current, role: "assistant", content: "请先在顶部配置 API Key", reference_image_urls: null, created_at: new Date().toISOString() },
      ]);
      return;
    }
    const effectiveProjectId = await ensureProject();
    if (!effectiveProjectId) {
      setChatMessages((prev) => [
        ...prev,
        { id: `err-${Date.now()}`, project_id: null, role: "assistant", content: "没有项目，自动创建项目失败，请先登录或退出访客模式后重试", reference_image_urls: null, created_at: new Date().toISOString() },
      ]);
      return;
    }

    const effectiveModel = imageModel;
    const isNanoBanana = effectiveModel.startsWith("nano-banana");
    const styleSuffix = STYLE_PRESETS.find((s) => s.value === stylePreset)?.suffix || "";
    const activeStylePack = options.stylePackId
      ? assetStylePacks.find((pack) => pack.id === options.stylePackId) || getGenerationStylePack(options.stylePackId)
      : selectedStylePack;
    const packSuffix = activeStylePack?.promptSuffix || "";
    const sizeStr = options.size || imageSize;
    const referenceList = normalizeReferenceUrls([...(options.referenceImages ?? referenceImages), ...getStylePackReferences(activeStylePack)]).urls;
    const { w: displayW, h: displayH } = getAspectSize(sizeStr || "1:1");
    const placeholderId = `placeholder-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;

    // Add placeholder directly into canvasImages for concurrent display
    // Use functional update so each placeholder sees the latest state (prevents overlap)
    const placeholder: CanvasImage = {
      id: placeholderId,
      image_url: "",
      image_key: "",
      project_id: effectiveProjectId,
      prompt,
      canvas_x: 0, // temporary, will be recalculated to viewport center
      canvas_y: 0,
      canvas_width: displayW,
      canvas_height: displayH,
      size: sizeStr || "1:1",
      model: effectiveModel,
      status: "generating",
      is_favorite: false,
      isGenerating: true,
      generateStartTime: Date.now(),
      reference_images: referenceList.length > 0 ? JSON.stringify(referenceList) : null,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString(),
    };

    // Calculate position BEFORE setCanvasImages so we can use it for panCanvasToPosition
    const GAP = 16;
    const existingImages = canvasImagesRef.current;
    const overlaps = (tx: number, ty: number, imgs: CanvasImage[]) =>
      imgs.some((img) =>
        tx < img.canvas_x + img.canvas_width + GAP &&
        tx + displayW + GAP > img.canvas_x &&
        ty < img.canvas_y + img.canvas_height + GAP &&
        ty + displayH + GAP > img.canvas_y
      );
    // Start from image cluster edge (adjacent to existing images, not far away)
    const clusterPos = getImageClusterPosition(displayW, displayH);
    let pos = { x: clusterPos.x, y: clusterPos.y };

    // Find generating placeholders — arrange new ones adjacent to existing ones
    const generatingImgs = existingImages.filter((img) => img.isGenerating || img.isUploading);
    if (generatingImgs.length > 0) {
      // Find the rightmost generating placeholder
      const rightmost = generatingImgs.reduce((max, img) => {
        const right = img.canvas_x + img.canvas_width;
        return right > max.right ? { x: img.canvas_x, y: img.canvas_y, right, bottom: img.canvas_y + img.canvas_height } : max;
      }, { x: 0, y: 0, right: 0, bottom: 0 });

      // Try placing to the right of the rightmost generating placeholder
      const tryX = rightmost.right + GAP;
      const tryY = rightmost.y;
      // Align Y with the first generating placeholder row
      const firstRowY = generatingImgs.reduce((minY, img) => Math.min(minY, img.canvas_y), Infinity);
      const candidateY = isFinite(firstRowY) ? firstRowY : tryY;

      // Check if placing to the right fits within a reasonable viewport width
      const vc = getViewportCenter();
      const container = document.getElementById('canvas-container');
      const viewW = container ? container.clientWidth : 1200;
      const maxRight = vc.x + viewW / (2 * canvasScaleRef.current);

      if (tryX + displayW <= maxRight && !overlaps(tryX, candidateY, existingImages)) {
        pos = { x: tryX, y: candidateY };
      } else {
        // Wrap to next row below the generating row
        const bottomY = generatingImgs.reduce((max, img) => Math.max(max, img.canvas_y + img.canvas_height), 0);
        const newRowY = bottomY + GAP;
        if (!overlaps(clusterPos.x, newRowY, existingImages)) {
          pos = { x: clusterPos.x, y: newRowY };
        } else if (!overlaps(tryX, candidateY, existingImages)) {
          pos = { x: tryX, y: candidateY };
        }
      }
    }
    placeholder.canvas_x = pos.x;
    placeholder.canvas_y = pos.y;

    // Pan canvas so the placeholder group is centered in viewport
    // When multiple generating placeholders exist, center the bounding box of all of them
    const allGenerating = canvasImagesRef.current.filter((img) => img.isGenerating || img.isUploading);
    if (allGenerating.length > 1) {
      const minX = allGenerating.reduce((m, img) => Math.min(m, img.canvas_x), Infinity);
      const minY = allGenerating.reduce((m, img) => Math.min(m, img.canvas_y), Infinity);
      const maxX = allGenerating.reduce((m, img) => Math.max(m, img.canvas_x + img.canvas_width), -Infinity);
      const maxY = allGenerating.reduce((m, img) => Math.max(m, img.canvas_y + img.canvas_height), -Infinity);
      const groupCX = (minX + maxX) / 2;
      const groupCY = (minY + maxY) / 2;
      const groupW = maxX - minX;
      const groupH = maxY - minY;
      panCanvasToPosition(groupCX - groupW / 2, groupCY - groupH / 2, groupW, groupH);
    } else {
      panCanvasToPosition(pos.x, pos.y, displayW, displayH);
    }

    // Add placeholder to canvas (simple push since position is already calculated)
    setCanvasImages((prev) => [placeholder, ...prev]);
    // Immediately update ref so concurrent generateImage calls can see this placeholder
    canvasImagesRef.current = [placeholder, ...canvasImagesRef.current];

    // Run generation independently (non-blocking)
    const abortController = new AbortController();
    generateAbortControllers.current.set(placeholderId, abortController);

    try {
      const res = await fetch("/api/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify({
          prompt: appendPromptSuffix(prompt + styleSuffix, packSuffix),
          size: sizeStr,
          apiKey,
          baseUrl,
          model: effectiveModel,
          imageSize: isNanoBanana ? imageResolution : undefined,
          projectId: effectiveProjectId,
          referenceImages: referenceList.length > 0 ? referenceList : undefined,
        }),
        signal: abortController.signal,
      });

      const data = await res.json();
      if (!res.ok) {
        const errorDetail = typeof data?.error === "string" && data.error.trim()
          ? data.error.trim()
          : "生成失败";
        // Mark placeholder as failed (show FailedPlaceholder instead of removing)
        setCanvasImages((prev) => prev.map((img) => img.id === placeholderId ? { ...img, status: 'failed', isGenerating: false, prompt: `${prompt}\n${errorDetail}` } : img));
        canvasImagesRef.current = canvasImagesRef.current.map((img) => img.id === placeholderId ? { ...img, status: 'failed', isGenerating: false, prompt: `${prompt}\n${errorDetail}` } : img);
        setActionToast(errorDetail);
        setTimeout(() => setActionToast(null), 2600);
      // 失败通过画布失败卡反馈，避免在聊天里堆叠错误文本噪音
      } else {
        // Replace placeholder with real image
        const newSizeStr = data.size || "1:1";
        let finalW = displayW;
        let finalH = displayH;
        if (newSizeStr.includes("x")) {
          const [pw, ph] = newSizeStr.split("x").map(Number);
          if (pw && ph) {
            const ratio = pw / ph;
            if (ratio >= 1) { finalW = 320; finalH = Math.round(320 / ratio); }
            else { finalH = 320; finalW = Math.round(320 * ratio); }
          }
        }
        // Center the final image relative to the placeholder so they visually overlap
        const phW = placeholder.canvas_width;
        const phH = placeholder.canvas_height;
        const finalX = Math.round(placeholder.canvas_x + (phW - finalW) / 2);
        const finalY = Math.round(placeholder.canvas_y + (phH - finalH) / 2);
        const newImage: CanvasImage = {
          ...data,
          canvas_x: finalX,
          canvas_y: finalY,
          canvas_width: finalW,
          canvas_height: finalH,
          isGenerating: false,
        };
        setCanvasImages((prev) => prev.map((img) => (img.id === placeholderId ? newImage : img)));
        canvasImagesRef.current = canvasImagesRef.current.map((img) => (img.id === placeholderId ? newImage : img));
        // Update position on server
        fetch("/api/history", {
          method: "PATCH",
          headers: { "Content-Type": "application/json", ...getAuthHeaders() },
          body: JSON.stringify({ id: data.id, canvas_x: finalX, canvas_y: finalY, canvas_width: finalW, canvas_height: finalH }),
        }).catch(() => {});
        // Sync generated image URL to the latest assistant chat message
        setChatMessages((prev) => {
          const lastAssistantIdx = [...prev].reverse().findIndex((m) => m.role === "assistant");
          if (lastAssistantIdx !== -1) {
            const realIdx = prev.length - 1 - lastAssistantIdx;
            const updated = [...prev];
            updated[realIdx] = { ...updated[realIdx], image_url: data.image_url };
            if (updated[realIdx].id && !updated[realIdx].id.startsWith("local-")) {
              fetch("/api/chat", {
                method: "PATCH",
                headers: { "Content-Type": "application/json", ...getAuthHeaders() },
                body: JSON.stringify({ id: updated[realIdx].id, image_url: data.image_url }),
              }).catch(() => {});
            }
            return updated;
          }
          return prev;
        });
      }
    } catch (err) {
      // If aborted by user, just clean up silently (placeholder already removed by cancelGeneration)
      if (err instanceof DOMException && err.name === 'AbortError') {
        // Already removed by cancelGeneration, nothing to do
        return;
      }
      const errorDetail = err instanceof Error ? err.message : "生成失败";
      // Mark placeholder as failed on network error
      setCanvasImages((prev) => prev.map((img) => img.id === placeholderId ? { ...img, status: 'failed', isGenerating: false, prompt: `${prompt}\n${errorDetail}` } : img));
      canvasImagesRef.current = canvasImagesRef.current.map((img) => img.id === placeholderId ? { ...img, status: 'failed', isGenerating: false, prompt: `${prompt}\n${errorDetail}` } : img);
      setActionToast(errorDetail);
      setTimeout(() => setActionToast(null), 2600);
      // 失败通过画布失败卡反馈，避免在聊天里堆叠错误文本噪音
    } finally {
      // Clean up AbortController reference
      generateAbortControllers.current.delete(placeholderId);
      // Clean up referenceImages only if no other images are generating
      if (!canvasImagesRef.current.some((img) => img.isGenerating)) {
        setReferenceImages([]);
      }
