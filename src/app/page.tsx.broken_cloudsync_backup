    const parts: string[] = [];
    const referenceUrls: string[] = [];

    const walk = (node: ChildNode) => {
      if (node.nodeType === Node.TEXT_NODE) {
        parts.push(node.textContent || "");
        return;
      }
      if (!(node instanceof HTMLElement)) return;
      if (node.tagName === "BR") {
        parts.push("\n");
        return;
      }
      if (node.dataset.type === "ref-chip") {
        const label = node.dataset.label || "图片";
        parts.push(`[@${label}]`);
        if (node.dataset.url) referenceUrls.push(node.dataset.url);
        return;
      }
      node.childNodes.forEach(walk);
    };

    el?.childNodes.forEach(walk);
    const text = parts.join("");
    const instructionText = text.replace(/\[@[^\]]+\]/g, "").replace(/\u00a0/g, " ").trim();
    return { text, instructionText, referenceUrls: normalizeReferenceUrls(referenceUrls).urls };
