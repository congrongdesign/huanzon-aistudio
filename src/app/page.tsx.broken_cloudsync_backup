        const records: CanvasImage[] = data.records || [];
        // Auto-layout: only resolve overlaps for images still at default position (40,40)
        const positioned: CanvasImage[] = [];
	        for (const img of records) {
	          const isDefaultPosition = img.canvas_x === 40 && img.canvas_y === 40;
	          if (isDefaultPosition) {
	            const overlap = positioned.some(
	              (p) => {
	                const imgDisplay = getCanvasImageDisplaySize(img);
	                const pDisplay = getCanvasImageDisplaySize(p);
	                return (
	                img.canvas_x < p.canvas_x + pDisplay.w + 16 &&
	                img.canvas_x + imgDisplay.w + 16 > p.canvas_x &&
	                img.canvas_y < p.canvas_y + pDisplay.h + 16 &&
	                img.canvas_y + imgDisplay.h + 16 > p.canvas_y
	                );
	              }
	            );
	            if (overlap) {
	              const newPos = { x: 40, y: 40 };
	              // Find first non-overlapping position
	              for (const p of positioned) {
	                const pDisplay = getCanvasImageDisplaySize(p);
	                const imgDisplay = getCanvasImageDisplaySize(img);
	                const testX = p.canvas_x + pDisplay.w + 16;
	                if (!positioned.some(
	                  (q) => {
	                    const qDisplay = getCanvasImageDisplaySize(q);
	                    return (
	                    testX < q.canvas_x + qDisplay.w + 16 &&
	                    testX + imgDisplay.w + 16 > q.canvas_x &&
	                    img.canvas_y < q.canvas_y + qDisplay.h + 16 &&
	                    img.canvas_y + imgDisplay.h + 16 > q.canvas_y
	                    );
	                  }
	                )) {
	                  newPos.x = testX;
	                  newPos.y = p.canvas_y;
                  break;
                }
              }
              const fixed = { ...img, canvas_x: newPos.x, canvas_y: newPos.y };
              positioned.push(fixed);
              // Save fixed position
              fetch("/api/history", {
                method: "PATCH",
                headers: { "Content-Type": "application/json", ...getAuthHeaders() },
                body: JSON.stringify({ id: fixed.id, canvas_x: Math.round(fixed.canvas_x), canvas_y: Math.round(fixed.canvas_y) }),
              }).catch(() => {});
            } else {
              positioned.push(img);
            }
          } else {
            // User positioned image - keep as is
            positioned.push(img);
          }
        }
        const seen = new Set<string>();
        const deduped = positioned.filter((img: CanvasImage) => {
          if (seen.has(img.id)) return false;
          seen.add(img.id);
          return true;
        });
        setCanvasImages(deduped);
        // Auto-pan canvas to make the first image visible after loading
        if (deduped.length > 0) {
          // Use requestAnimationFrame to ensure DOM is ready before calculating viewport center
	          requestAnimationFrame(() => {
	            const first = deduped[0];
	            const display = getCanvasImageDisplaySize(first);
	            panCanvasToPosition(first.canvas_x, first.canvas_y, display.w, display.h);
	          });
        }
      })
      .catch(() => {});
    // Load chat
    fetch(`/api/chat?projectId=${currentProjectId}`, { headers: { ...getAuthHeaders() } })
      .then((r) => r.json())
      .then((data) => setChatMessages(data.messages || []))
