                          setCanvasImages(prev => prev.filter(i => i.id !== img.id));
                        }
                      }} onRemove={() => setCanvasImages(prev => prev.filter(i => i.id !== img.id))} />
                    ) : img.isUploading ? (
                      <div className="w-full h-full flex flex-col items-center justify-center bg-muted/80 rounded-lg">
                        <div className="relative w-10 h-10 mb-2">
                          <div className="absolute inset-0 border-2 border-border-secondary/35 rounded-full" />
