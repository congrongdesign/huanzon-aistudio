      if (!assetsRes.ok) throw new Error(assetsData.error || "读取资产失败");
      const assets = Array.isArray(assetsData.assets) ? assetsData.assets as DesignAsset[] : [];
      const assetIds = Array.from(new Set(assets.map((asset) => asset.id).filter(Boolean)));

      const [operationGroups, versionGroups] = await Promise.all([
        Promise.all(assetIds.map(async (assetId) => {
          const res = await fetch(`/api/design-operations?assetId=${encodeURIComponent(assetId)}`, { headers: getAuthHeaders() });
