  const visibleKnowledgeHubFolders = useMemo(() => {
    const childrenByParent = new Map<string | null, KnowledgeHubFolder[]>();
    for (const folder of khFolders) {
      const parent = folder.parentKey;
      const children = childrenByParent.get(parent) || [];
      children.push(folder);
      childrenByParent.set(parent, children);
    }
    for (const children of childrenByParent.values()) {
      children.sort((a, b) => {
        if (a.parentKey === null) return -1;
        if (b.parentKey === null) return 1;
        return (a.name || a.label).localeCompare(b.name || b.label, "zh-Hans-CN", { numeric: true });
      });
    }

    const result: KnowledgeHubFolder[] = [];
    const walk = (parentKey: string | null) => {
      const children = childrenByParent.get(parentKey) || [];
      for (const folder of children) {
        result.push(folder);
        if (khExpandedFolders.has(folder.key)) {
          walk(folder.key);
