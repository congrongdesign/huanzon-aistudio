};

function toPlainObject(value: unknown): Record<string, unknown> {
  return value && typeof value === "object" && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : {};
}

function toTrimmedString(value: unknown): string {
  return typeof value === "string" ? value.trim() : "";
}

function toSafeNumber(value: unknown): number {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : 0;
}

function parseAssetIndexJobItem(value: unknown): AssetIndexJobItem | null {
  const obj = toPlainObject(value);
  const id = toTrimmedString(obj.id);
  if (!id) return null;

  const mode = obj.mode === "project" || obj.mode === "ids" ? obj.mode : "full";
  const status = toTrimmedString(obj.status) || "queued";
  const sourceCount = Math.max(0, Math.round(toSafeNumber(obj.source_count)));
  const indexedCount = Math.max(0, Math.round(toSafeNumber(obj.indexed_count)));
  const failedCount = Math.max(0, Math.round(toSafeNumber(obj.failed_count)));
  const error = toTrimmedString(obj.error);
  const errorCode = toTrimmedString(obj.error_code);
  const retryable = typeof obj.retryable === "boolean" ? obj.retryable : null;
  const startedAt = toTrimmedString(obj.started_at);
  const completedAt = toTrimmedString(obj.completed_at);
  const createdAt = toTrimmedString(obj.created_at) || new Date().toISOString();
  const updatedAt = toTrimmedString(obj.updated_at);

  return {
    id,
    mode,
    status,
    source_count: sourceCount,
    indexed_count: indexedCount,
    failed_count: failedCount,
    params: toPlainObject(obj.params),
    stats: toPlainObject(obj.stats),
    error: error || null,
    error_code: errorCode || null,
    retryable,
    started_at: startedAt || null,
    completed_at: completedAt || null,
    created_at: createdAt,
    updated_at: updatedAt || null,
  };
}

function getAssetIndexJobDurationMs(job: AssetIndexJobItem): number {
  const fromStats = toSafeNumber(toPlainObject(job.stats).durationMs);
  if (fromStats > 0) return Math.round(fromStats);
  if (!job.started_at || !job.completed_at) return 0;
  const start = new Date(job.started_at).getTime();
  const end = new Date(job.completed_at).getTime();
  if (!Number.isFinite(start) || !Number.isFinite(end)) return 0;
  return Math.max(0, Math.round(end - start));
}

function formatDurationMs(ms: number): string {
  if (!Number.isFinite(ms) || ms <= 0) return "-";
  const seconds = Math.max(0, Math.round(ms / 1000));
  if (seconds < 60) return `${seconds}s`;
  const minutes = Math.floor(seconds / 60);
  const remain = seconds % 60;
  if (minutes < 60) return `${minutes}m ${remain}s`;
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return `${hours}h ${mins}m`;
}

function isLocalApiEndpoint(url?: string): boolean {
  if (!url) return false;
  return /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?/i.test(url.trim());
}

function normalizeReferenceUrls(urls: string[], maxCount = MAX_MODEL_REFERENCE_IMAGES) {
  const unique = Array.from(new Set(urls.filter(Boolean)));
  return {
    urls: unique.slice(0, maxCount),
    ignored: Math.max(0, unique.length - maxCount),
  };
}

function parseReferenceImageUrls(value?: string | null): string[] {
  if (!value) return [];
  try {
    const parsed = JSON.parse(value) as unknown;
    return Array.isArray(parsed) ? parsed.filter((url): url is string => typeof url === "string" && Boolean(url)) : [];
  } catch {
    return [];
  }
}

function getStylePackReferences(pack?: GenerationStylePack | null) {
  return Array.isArray(pack?.referenceImages) ? pack.referenceImages.filter(Boolean) : [];
}

function formatBytes(size: number) {
  if (!Number.isFinite(size) || size <= 0) return "0 KB";
  if (size < 1024 * 1024) return `${Math.max(1, Math.round(size / 1024))} KB`;
  return `${(size / 1024 / 1024).toFixed(size < 10 * 1024 * 1024 ? 1 : 0)} MB`;
}

function formatCompactDateTime(value?: string | null) {
  if (!value) return "-";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "-";
  return date.toLocaleString("zh-CN", {
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  });
}

