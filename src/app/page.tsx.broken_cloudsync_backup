          data-ui-resize-handle="true"
          className="absolute right-0 top-0 bottom-0 w-1 cursor-col-resize hover:bg-muted/70 transition-colors z-10"
          onMouseDown={(e) => {
            e.preventDefault();
            const startX = e.clientX;
            const startWidth = navRailWidth;
            const onMove = (ev: MouseEvent) => {
              const delta = ev.clientX - startX;
              const newWidth = Math.max(40, Math.min(120, startWidth + delta));
              setNavRailWidth(newWidth);
            };
            const onUp = () => {
              document.removeEventListener('mousemove', onMove);
