  // ─── Paste image from clipboard ───
  const handlePaste = useCallback(async (e: ClipboardEvent) => {
    const items = e.clipboardData?.items;
    if (!items) return;

    const imageFiles: File[] = [];
    for (const item of Array.from(items)) {
      if (item.type.startsWith("image/")) {
        const file = item.getAsFile();
        if (file) imageFiles.push(file);
      }
    }
    if (imageFiles.length === 0) return;

    // Only paste when not typing in input/textarea/contentEditable
    const target = e.target as HTMLElement;
    const tag = target?.tagName;
    if (tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || target?.isContentEditable) return;

    e.preventDefault();
    setRefUploading(true);

    for (const file of imageFiles) {
      // Step 1: Get image dimensions immediately via createObjectURL (no upload needed)
      const objectUrl = URL.createObjectURL(file);
      const dimPromise = new Promise<{ w: number; h: number }>((resolve) => {
        const img = new Image();
        img.onload = () => resolve({ w: img.naturalWidth, h: img.naturalHeight });
        img.onerror = () => resolve({ w: 320, h: 320 }); // fallback
        img.src = objectUrl;
      });
      const { w: natW, h: natH } = await dimPromise;
      const aspect = natW / natH;
      const displayW = 320;
      const displayH = Math.round(displayW / aspect);

      // Step 2: Calculate position (image cluster edge + find nearest blank)
      const pos = findNonOverlappingPosition(...(() => {
        const cp = getImageClusterPosition(displayW, displayH);
        return [cp.x, cp.y] as [number, number];
      })(), displayW, displayH);

      // Step 3: Add placeholder with correct dimensions at the computed position
      const placeholderId = `paste-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`;
      const placeholder: CanvasImage = {
        id: placeholderId,
        project_id: currentProjectId,
        prompt: `粘贴: ${file.name || "clipboard-image"}`,
        image_url: "",
        image_key: "",
        reference_images: null,
        canvas_x: pos.x, canvas_y: pos.y,
        canvas_width: displayW, canvas_height: displayH,
        size: `${aspect.toFixed(2)}:1`,
        model: "upload",
        status: "completed",
        is_favorite: false,
        created_at: new Date().toISOString(),
        updated_at: null,
        is_reference: true,
        isUploading: true,
      };

      // Only show placeholder if upload takes > 300ms
      const placeholderTimer = setTimeout(() => {
        setCanvasImages((prev) => [...prev, placeholder]);
        canvasImagesRef.current = [...canvasImagesRef.current, placeholder];
        panCanvasToPosition(pos.x, pos.y, displayW, displayH);
      }, 300);

      // Step 4: Upload to S3
      const formData = new FormData();
      formData.append("file", file);
