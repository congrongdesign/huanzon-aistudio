          className={`w-9 h-9 rounded-lg flex flex-col items-center justify-center gap-0.5 transition-all duration-150 mb-0.5 group relative ${(!galleryOpen && navMode === 'prompt') ? 'bg-muted text-foreground ring-1 ring-border/80' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`}
