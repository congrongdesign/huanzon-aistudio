          ? "麦克风权限被拒绝，请在浏览器地址栏允许麦克风"
          : code === "no-speech"
            ? "没有听到声音，请靠近麦克风再试"
            : "语音输入失败，请重试";
        setVoiceMessage(message);
        setVoiceListening(false);
        setVoiceInterimText("");
        voiceRecognitionRef.current = null;
        window.setTimeout(() => setVoiceMessage(null), 2600);
      };
      recognition.onend = () => {
        setVoiceListening(false);
        setVoiceInterimText("");
        voiceRecognitionRef.current = null;
        if (voiceFinalTextRef.current.trim()) {
          setVoiceMessage("语音已转成文字");
          window.setTimeout(() => setVoiceMessage(null), 1400);
        } else {
          setVoiceMessage((prev) => prev && prev !== "正在听写，说完后点按钮停止" && prev !== "正在整理语音..." ? prev : "没有识别到语音");
          window.setTimeout(() => setVoiceMessage(null), 1600);
        }
      };
      recognition.onresult = (event) => {
        let finalText = "";
        let interimText = "";
        for (let index = event.resultIndex; index < event.results.length; index += 1) {
          const result = event.results[index];
          const transcript = result[0]?.transcript || "";
          if (result.isFinal) {
            finalText += transcript;
          } else {
            interimText += transcript;
          }
        }
        if (finalText.trim()) {
          voiceFinalTextRef.current += finalText;
          appendTextToRichInput(finalText);
        }
        setVoiceInterimText(interimText.trim());
      };
      recognition.start();
    } catch (err) {
      setVoiceListening(false);
      setVoiceInterimText("");
      setVoiceMessage(err instanceof Error ? err.message : "语音输入启动失败");
      window.setTimeout(() => setVoiceMessage(null), 2600);
    }
  };

  const toggleVoiceInput = () => {
    if (voiceListening) {
      stopVoiceInput();
    } else {
      startVoiceInput();
    }
  };

  useEffect(() => () => {
    voiceRecognitionRef.current?.abort();
  }, []);

  // Helper: create a DOM chip element for inline ref image
  const createInlineRefChip = (url: string, label: string, isDeleted?: boolean) => {
    const chip = document.createElement('span');
    chip.contentEditable = 'false';
    chip.dataset.type = 'ref-chip';
    chip.dataset.label = label;
    chip.dataset.url = url;
    chip.className = `inline-flex max-w-[150px] items-center gap-1 mx-0.5 rounded-full border px-1.5 py-0.5 text-xs align-middle ${isDeleted ? 'border-red-400/40 bg-red-500/10 opacity-50' : 'border-border bg-muted/80 text-foreground'} overflow-hidden`;
    if (isDeleted) chip.title = '原图已被删除，可能无法正常引用';
    const thumb = document.createElement('img');
    thumb.src = url;
    thumb.className = `h-5 w-5 shrink-0 rounded-full object-cover ${isDeleted ? 'opacity-40' : ''}`;
    thumb.alt = label;
    thumb.dataset.refUrl = url;
    chip.appendChild(thumb);
    const text = document.createElement('span');
    text.textContent = label;
    text.className = 'max-w-[108px] truncate leading-none';
    chip.appendChild(text);
    if (isDeleted) {
      const delBadge = document.createElement('span');
      delBadge.textContent = '!';
      delBadge.className = 'ml-0.5 text-[8px] text-red-500';
      chip.appendChild(delBadge);
    }
    return chip;
  };

  // Insert an inline reference chip at current cursor position in contentEditable div
  const handleInsertInlineRef = (img: {id: string; url: string; label: string; prompt: string}) => {
    const el = richInputRef.current;
    if (!el) return;
    el.focus();
    
    // Create chip element
    const chip = createInlineRefChip(img.url, img.label);
    chip.dataset.id = img.id;
    
    // Insert at cursor
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0) {
      const range = sel.getRangeAt(0);
      // Remove the @mention text first
      const atStart = atMentionStartRef.current;
      if (atStart >= 0) {
        // Find and remove @text in the text node at cursor
        const textNode = range.startContainer;
        if (textNode.nodeType === Node.TEXT_NODE && textNode.textContent) {
          const text = textNode.textContent;
          const atIdx = text.lastIndexOf('@', range.startOffset);
          if (atIdx >= 0) {
            const before = text.substring(0, atIdx);
            const after = text.substring(range.startOffset);
            textNode.textContent = before + after;
            range.setStart(textNode, before.length);
            range.collapse(true);
          }
        }
      }
      range.insertNode(chip);
      // Move cursor after chip
      range.setStartAfter(chip);
      range.collapse(true);
      sel.removeAllRanges();
      sel.addRange(range);
    } else {
      el.appendChild(chip);
    }
    
    // Add a space after chip for continued typing
    const space = document.createTextNode('\u00A0');
    chip.after(space);
    
    // Sync text to state
    syncChatInputFromRich();
  };

  const insertReferenceChipsAtCursor = useCallback((items: Array<{ url: string; id?: string; label?: string }>) => {
    const el = richInputRef.current;
    if (!el || items.length === 0) return;

    const existingUrls = new Set(
      Array.from(el.querySelectorAll<HTMLElement>('[data-type="ref-chip"]'))
        .map((chip) => chip.dataset.url)
        .filter(Boolean) as string[],
    );
    const refs = items.filter((item) => item.url && !existingUrls.has(item.url));
    if (refs.length === 0) return;

    el.focus();
    const selection = window.getSelection();
    let range: Range | null = null;
    if (selection && selection.rangeCount > 0) {
      const candidate = selection.getRangeAt(0);
      if (el.contains(candidate.commonAncestorContainer)) range = candidate;
    }
    if (!range) {
      range = document.createRange();
      range.selectNodeContents(el);
      range.collapse(false);
    }

    refs.forEach((item, index) => {
      const image = canvasImagesRef.current.find((img) => img.image_url === item.url);
      const fallbackLabel = refs.length > 1 ? `图${index + 1}` : "图片";
      const label = item.label || (image?.prompt ? image.prompt.replace(/^上传:\s*/, "").slice(0, 8) : fallbackLabel);
      const chip = createInlineRefChip(item.url, label);
      chip.dataset.id = item.id || image?.id || "";
      range!.insertNode(chip);
      range!.setStartAfter(chip);
      range!.collapse(true);
      const space = document.createTextNode("\u00A0");
      range!.insertNode(space);
      range!.setStartAfter(space);
      range!.collapse(true);
    });

    selection?.removeAllRanges();
    selection?.addRange(range);
    syncChatInputFromRich();
  }, []);

  const setRichInputContentWithReferences = useCallback((content: string, items: Array<{ url: string; id?: string; label?: string }>) => {
    const el = richInputRef.current;
    const uniqueItems: Array<{ url: string; id?: string; label?: string }> = [];
    const seen = new Set<string>();
    for (const item of items) {
      if (!item.url || seen.has(item.url)) continue;
      seen.add(item.url);
      uniqueItems.push(item);
    }

    if (!el) {
      const plain = content.replace(/\[@[^\]]+\]/g, "").trim();
      setChatInput(plain);
      setReferenceImages(uniqueItems.map((item) => item.url));
      setRichReferenceUrls(uniqueItems.map((item) => item.url));
      return;
    }

    const insertPlainText = (range: Range, value: string) => {
      const normalizedValue = value.replace(/\r/g, "");
      const lines = normalizedValue.split("\n");
      lines.forEach((line, index) => {
        if (index > 0) {
          const br = document.createElement("br");
          range.insertNode(br);
          range.setStartAfter(br);
          range.collapse(true);
        }
        if (line) {
          const textNode = document.createTextNode(line);
          range.insertNode(textNode);
          range.setStartAfter(textNode);
          range.collapse(true);
        }
      });
    };

    el.focus();
    el.innerHTML = "";

    const selection = window.getSelection();
    const range = document.createRange();
    range.selectNodeContents(el);
    range.collapse(false);

    let refIndex = 0;
    const parts = content.split(/(\[@[^\]]+\])/g);

    for (const part of parts) {
      if (!part) continue;
      const tokenMatch = part.match(/^\[@([^\]]+)\]$/);
      if (tokenMatch) {
        const tokenLabel = tokenMatch[1] || `图${refIndex + 1}`;
        const item = uniqueItems[refIndex];
        if (item?.url) {
          const image = canvasImagesRef.current.find((img) => img.image_url === item.url);
          const chip = createInlineRefChip(
            item.url,
            item.label || tokenLabel || image?.prompt?.replace(/^上传:\s*/, "").slice(0, 8) || `图${refIndex + 1}`,
          );
          chip.dataset.id = item.id || image?.id || "";
          range.insertNode(chip);
          range.setStartAfter(chip);
          range.collapse(true);
          const space = document.createTextNode("\u00A0");
          range.insertNode(space);
          range.setStartAfter(space);
          range.collapse(true);
          refIndex += 1;
        }
        continue;
      }
      insertPlainText(range, part);
    }

    while (refIndex < uniqueItems.length) {
      const item = uniqueItems[refIndex];
      const image = canvasImagesRef.current.find((img) => img.image_url === item.url);
      const chip = createInlineRefChip(
        item.url,
        item.label || image?.prompt?.replace(/^上传:\s*/, "").slice(0, 8) || `图${refIndex + 1}`,
      );
      chip.dataset.id = item.id || image?.id || "";
      range.insertNode(chip);
      range.setStartAfter(chip);
      range.collapse(true);
      const space = document.createTextNode("\u00A0");
      range.insertNode(space);
      range.setStartAfter(space);
      range.collapse(true);
      refIndex += 1;
    }

    selection?.removeAllRanges();
    selection?.addRange(range);
    syncChatInputFromRich();
    setChatPanelOpen(true);
    setChatInputFocused(true);
    window.setTimeout(() => richInputRef.current?.focus(), 0);
  }, []);

  // (richInput sync moved after chatInput declaration)

  // Expand mode
  const [expandMode, setExpandMode] = useState<{
    imageId: string;
    expandLeft: number; expandRight: number; expandTop: number; expandBottom: number;
    targetRatio?: string;
    imageOffsetX: number; imageOffsetY: number;
  } | null>(null);

  // Inpaint mode (局部重绘)
  const [inpaintMode, setInpaintMode] = useState<{
    imageId: string;
    strokes: { x: number; y: number }[][]; // array of stroke paths
    brushSize: number;
    prompt: string;
  } | null>(null);
  const [inpaintAutoSelecting, setInpaintAutoSelecting] = useState(false);
  const [inpaintRectSelecting, setInpaintRectSelecting] = useState(false);
  const [inpaintRectStart, setInpaintRectStart] = useState<{ x: number; y: number } | null>(null);
  const [inpaintRectEnd, setInpaintRectEnd] = useState<{ x: number; y: number } | null>(null);
  const [inpaintElementMap, setInpaintElementMap] = useState<InpaintElementMap | null>(null);
  const [inpaintSmartMaskBase64, setInpaintSmartMaskBase64] = useState<string | null>(null);
  const [inpaintHoverElementId, setInpaintHoverElementId] = useState<number | null>(null);
  const [inpaintSelectedElementIds, setInpaintSelectedElementIds] = useState<number[]>([]);
  const [inpaintMaskHasSelection, setInpaintMaskHasSelection] = useState(false);
  const [inpaintAntsPhase, setInpaintAntsPhase] = useState(0);
  const [inpaintDrawing, setInpaintDrawing] = useState(false);
  const [inpaintCurrentStroke, setInpaintCurrentStroke] = useState<{ x: number; y: number }[]>([]);
  const inpaintCurrentStrokeRef = useRef<{ x: number; y: number }[]>([]);
  const inpaintBrushEraseRef = useRef(false);
  const inpaintClickCandidateRef = useRef<{ hitId: number | null; multiSelect: boolean; shiftClear: boolean } | null>(null);
  const inpaintAutoDetectAttemptedRef = useRef<string | null>(null);
  const inpaintCanvasRef = useRef<HTMLCanvasElement>(null);
  const inpaintPreviewCanvasRef = useRef<HTMLCanvasElement>(null);
  const inpaintElementLookup = useMemo(() => {
    const map = new Map<number, InpaintElementItem>();
    for (const item of inpaintElementMap?.elements || []) {
      map.set(item.id, item);
    }
    return map;
  }, [inpaintElementMap]);
  const imgOrigSizeRef = useRef<Record<string, { w: number; h: number }>>({});

  const rememberNaturalImageSize = useCallback((keys: string | string[], width: number, height: number) => {
    if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) return;
    const keyList = Array.isArray(keys) ? keys : [keys];
    setNaturalImageSizes((prev) => {
      let changed = false;
      const next = { ...prev };
      for (const key of keyList) {
        if (!key) continue;
        const old = next[key];
        if (!old || old.w !== width || old.h !== height) {
          next[key] = { w: width, h: height };
          changed = true;
        }
      }
      return changed ? next : prev;
    });
  }, []);

  const getImageRatio = useCallback((keys: string | string[], fallbackWidth?: number, fallbackHeight?: number, fallback = 1) => {
    const keyList = Array.isArray(keys) ? keys : [keys];
    for (const key of keyList) {
      const size = naturalImageSizes[key];
      if (size?.w && size?.h) return size.w / size.h;
    }
    if (fallbackWidth && fallbackHeight && fallbackWidth > 0 && fallbackHeight > 0) {
      return fallbackWidth / fallbackHeight;
    }
    return fallback;
  }, [naturalImageSizes]);

  const getCanvasImageDisplaySize = useCallback((img: CanvasImage) => {
    const currentW = Math.max(1, Math.round(img.canvas_width || 320));
    const currentH = Math.max(1, Math.round(img.canvas_height || 320));
    if (img.isGenerating || img.isUploading || img.status === "failed" || !img.image_url) {
      return { w: currentW, h: currentH };
    }

    const ratio = getImageRatio([`canvas:${img.id}`, `url:${img.image_url}`], currentW, currentH, currentW / currentH);
    if (!Number.isFinite(ratio) || ratio <= 0) return { w: currentW, h: currentH };
    if (Math.abs(currentW / currentH - ratio) / ratio < 0.015) return { w: currentW, h: currentH };

    const maxSide = Math.max(60, currentW, currentH);
    if (ratio >= 1) {
      return { w: Math.round(maxSide), h: Math.max(1, Math.round(maxSide / ratio)) };
    }
    return { w: Math.max(1, Math.round(maxSide * ratio)), h: Math.round(maxSide) };
  }, [getImageRatio]);

  const handleCanvasNaturalSize = useCallback((img: CanvasImage, width: number, height: number) => {
    if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) return;
    imgOrigSizeRef.current[img.id] = { w: width, h: height };
    rememberNaturalImageSize([`canvas:${img.id}`, `gallery:${img.id}`, `url:${img.image_url}`], width, height);

    if (img.isGenerating || img.isUploading || resizingImageId === img.id || (expandMode && expandMode.imageId === img.id)) return;
    const currentW = img.canvas_width || 0;
    const currentH = img.canvas_height || 0;
    if (currentW <= 0 || currentH <= 0) return;
    const currentRatio = currentW / currentH;
    const naturalRatio = width / height;
    if (Math.abs(currentRatio - naturalRatio) / naturalRatio < 0.015) return;

    const maxSide = Math.max(60, currentW, currentH);
    const scale = maxSide / Math.max(width, height);
    const newW = Math.max(1, Math.round(width * scale));
    const newH = Math.max(1, Math.round(height * scale));
    if (Math.abs(newW - currentW) < 2 && Math.abs(newH - currentH) < 2) return;

    setCanvasImages((prev) => prev.map((item) => item.id === img.id ? { ...item, canvas_width: newW, canvas_height: newH } : item));
    fetch("/api/history", {
      method: "PATCH",
      headers: { "Content-Type": "application/json", ...getAuthHeaders() },
      body: JSON.stringify({ id: img.id, canvas_width: newW, canvas_height: newH }),
    }).catch(() => {});
  }, [expandMode, rememberNaturalImageSize, resizingImageId]);

  const syncInpaintCanvasResolution = useCallback((canvas: HTMLCanvasElement | null) => {
    if (!canvas) return false;
    const rect = canvas.getBoundingClientRect();
    const nextW = Math.max(1, Math.round(rect.width));
    const nextH = Math.max(1, Math.round(rect.height));
    if (canvas.width === nextW && canvas.height === nextH) return false;
    canvas.width = nextW;
    canvas.height = nextH;
    return true;
  }, []);

  // Keep inpaint mask canvas synced and redraw committed strokes.
  useEffect(() => {
    if (!inpaintMode || !inpaintCanvasRef.current) return;
    const canvas = inpaintCanvasRef.current;
    syncInpaintCanvasResolution(canvas);
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.globalAlpha = 0.5;
    ctx.fillStyle = "#ff4444";
    ctx.strokeStyle = "#ff4444";
    for (const stroke of inpaintMode.strokes) {
      if (stroke.length < 2) {
        ctx.beginPath();
        ctx.arc(stroke[0].x, stroke[0].y, inpaintMode.brushSize, 0, Math.PI * 2);
        ctx.fill();
      } else {
        ctx.lineWidth = inpaintMode.brushSize * 2;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        ctx.beginPath();
        ctx.moveTo(stroke[0].x, stroke[0].y);
        for (let i = 1; i < stroke.length; i++) {
          ctx.lineTo(stroke[i].x, stroke[i].y);
        }
        ctx.stroke();
      }
    }
  }, [inpaintMode?.imageId, inpaintMode?.brushSize, inpaintMode?.strokes, syncInpaintCanvasResolution]);

  useEffect(() => {
    if (!inpaintMode) return;
    if (inpaintSelectedElementIds.length === 0 && !inpaintRectSelecting) return;
    const timer = window.setInterval(() => {
      setInpaintAntsPhase((prev) => (prev + 1) % 24);
    }, 90);
    return () => window.clearInterval(timer);
  }, [inpaintMode, inpaintRectSelecting, inpaintSelectedElementIds.length]);

  // ─── Cancel expand mode (declared early to avoid TDZ) ───
  const cancelExpand = useCallback(() => {
    setExpandMode(null);
  }, []);

  const cancelInpaint = useCallback(() => {
    setInpaintMode(null);
    setInpaintRectSelecting(false);
    setInpaintRectStart(null);
    setInpaintRectEnd(null);
    setInpaintElementMap(null);
    setInpaintSmartMaskBase64(null);
    setInpaintMaskHasSelection(false);
    setInpaintHoverElementId(null);
    setInpaintSelectedElementIds([]);
    setInpaintDrawing(false);
    setInpaintCurrentStroke([]);
    inpaintCurrentStrokeRef.current = [];
    inpaintClickCandidateRef.current = null;
    inpaintBrushEraseRef.current = false;
    inpaintAutoDetectAttemptedRef.current = null;
  }, []);

  // Clear all inpaint strokes but stay in inpaint mode
  const clearInpaintCanvas = useCallback(() => {
    setInpaintMode(prev => prev ? {...prev, strokes: []} : null);
    setInpaintHoverElementId(null);
    setInpaintSelectedElementIds([]);
    setInpaintSmartMaskBase64(null);
    setInpaintMaskHasSelection(false);
    setInpaintCurrentStroke([]);
    inpaintCurrentStrokeRef.current = [];
    inpaintClickCandidateRef.current = null;
    inpaintBrushEraseRef.current = false;
    inpaintAutoDetectAttemptedRef.current = null;
    // Clear canvas pixels
    const canvas = inpaintCanvasRef.current;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
    }
    const preview = inpaintPreviewCanvasRef.current;
    if (preview) {
      const pctx = preview.getContext("2d");
      if (pctx) pctx.clearRect(0, 0, preview.width, preview.height);
    }
  }, []);

  const getInpaintElementIdAt = useCallback((x: number, y: number): number | null => {
    if (!inpaintElementMap) return null;
    const canvas = inpaintCanvasRef.current;
    const canvasW = Math.max(1, canvas?.width || inpaintElementMap.width);
    const canvasH = Math.max(1, canvas?.height || inpaintElementMap.height);
    const mapW = inpaintElementMap.width;
    const mapH = inpaintElementMap.height;
    const fx = Math.max(0, Math.min(mapW - 1, (x / canvasW) * mapW));
    const fy = Math.max(0, Math.min(mapH - 1, (y / canvasH) * mapH));
    const ix = Math.floor(fx);
    const iy = Math.floor(fy);
    const idx = iy * inpaintElementMap.width + ix;
    const id = inpaintElementMap.idMap[idx] || 0;
    if (id > 0) return id;

    const searchRadiusX = Math.max(2, Math.min(24, Math.round((8 * mapW) / canvasW)));
    const searchRadiusY = Math.max(2, Math.min(24, Math.round((8 * mapH) / canvasH)));
    const minX = Math.max(0, ix - searchRadiusX);
    const maxX = Math.min(mapW - 1, ix + searchRadiusX);
    const minY = Math.max(0, iy - searchRadiusY);
    const maxY = Math.min(mapH - 1, iy + searchRadiusY);
    const candidates = new Map<number, { count: number; closest: number }>();

    for (let py = minY; py <= maxY; py++) {
      const row = py * mapW;
      const dy = (py + 0.5) - fy;
      for (let px = minX; px <= maxX; px++) {
        const candidateId = inpaintElementMap.idMap[row + px] || 0;
        if (candidateId <= 0) continue;
        const dx = (px + 0.5) - fx;
        const dist = dx * dx + dy * dy;
        const current = candidates.get(candidateId);
        if (current) {
          current.count++;
          if (dist < current.closest) current.closest = dist;
        } else {
          candidates.set(candidateId, { count: 1, closest: dist });
        }
      }
    }

    let bestId: number | null = null;
    let bestScore = Number.NEGATIVE_INFINITY;
    for (const [candidateId, candidate] of candidates.entries()) {
      const element = inpaintElementLookup.get(candidateId);
      if (!element) continue;
      const bbox = element.bbox;
      const bboxRight = bbox.x + bbox.width;
      const bboxBottom = bbox.y + bbox.height;
      const inside = fx >= bbox.x && fx <= bboxRight && fy >= bbox.y && fy <= bboxBottom;
      const centerX = bbox.x + bbox.width / 2;
      const centerY = bbox.y + bbox.height / 2;
      const centerDistance = Math.hypot(fx - centerX, fy - centerY) / Math.max(1, Math.hypot(bbox.width, bbox.height));
      const smallBoost = Math.min(4.5, 90 / Math.sqrt(Math.max(1, element.area)));
      const densityBoost = Math.min(3, (candidate.count / Math.max(1, element.area)) * 220);
      const proximityBoost = 1 / (1 + Math.sqrt(candidate.closest)) * 4;
      const edgeBoost = Math.min(2, (element.edgeMean || 0) / 18);
      const fillBoost = Math.min(2, (element.fillRatio || 0) * 2.2);
      let score = (candidate.count * 1.35) + densityBoost + smallBoost + proximityBoost + edgeBoost + fillBoost - (centerDistance * 2.5);
      if (inside) score += 4.5;
      if (element.area <= 36) score += 1.25;
      if (score > bestScore) {
        bestScore = score;
        bestId = candidateId;
      }
    }

    return bestId;
  }, [inpaintElementLookup, inpaintElementMap]);

  const clearInpaintStrokePixels = useCallback(() => {
    const canvas = inpaintCanvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }, []);

  const getElementBounds = useCallback((id: number) => {
    return inpaintElementLookup.get(id)?.bbox || null;
  }, [inpaintElementLookup]);

  const setMaskFromElementIds = useCallback((ids: number[]) => {
    if (!inpaintElementMap || !inpaintCanvasRef.current) return false;
    const unique = Array.from(new Set(ids.filter((id) => id > 0)));
    if (unique.length === 0) return false;
    const idSet = new Set(unique);
    const canvas = inpaintCanvasRef.current;
    const maskCanvas = document.createElement("canvas");
    maskCanvas.width = canvas.width;
    maskCanvas.height = canvas.height;
    const mctx = maskCanvas.getContext("2d");
    if (!mctx) return false;
    const overlayCtx = canvas.getContext("2d");
    if (!overlayCtx) return false;

    const imageData = mctx.createImageData(maskCanvas.width, maskCanvas.height);
    const pixels = imageData.data;
    const overlayImageData = overlayCtx.createImageData(maskCanvas.width, maskCanvas.height);
    const overlayPixels = overlayImageData.data;
    const mapW = inpaintElementMap.width;
    const mapH = inpaintElementMap.height;

    for (let y = 0; y < maskCanvas.height; y++) {
      const my = Math.max(0, Math.min(mapH - 1, Math.floor(y * mapH / maskCanvas.height)));
      for (let x = 0; x < maskCanvas.width; x++) {
        const mx = Math.max(0, Math.min(mapW - 1, Math.floor(x * mapW / maskCanvas.width)));
        const id = inpaintElementMap.idMap[my * mapW + mx];
        const pi = (y * maskCanvas.width + x) * 4;
        pixels[pi] = 255;
        pixels[pi + 1] = 255;
        pixels[pi + 2] = 255;
        pixels[pi + 3] = 255;
        overlayPixels[pi] = 0;
        overlayPixels[pi + 1] = 0;
        overlayPixels[pi + 2] = 0;
        overlayPixels[pi + 3] = 0;
        if (!idSet.has(id)) continue;
        pixels[pi] = 0;
        pixels[pi + 1] = 0;
        pixels[pi + 2] = 0;
        overlayPixels[pi] = 255;
        overlayPixels[pi + 1] = 68;
        overlayPixels[pi + 2] = 68;
        overlayPixels[pi + 3] = 128;
      }
    }
    mctx.putImageData(imageData, 0, 0);
    overlayCtx.clearRect(0, 0, canvas.width, canvas.height);
    overlayCtx.putImageData(overlayImageData, 0, 0);
    const maskBase64 = maskCanvas.toDataURL("image/png");

    setInpaintSelectedElementIds(unique);
    setInpaintSmartMaskBase64(maskBase64);
    setInpaintMaskHasSelection(true);
    setInpaintMode((prev) => (prev ? { ...prev, strokes: [] } : prev));
    setInpaintCurrentStroke([]);
    inpaintCurrentStrokeRef.current = [];
    inpaintBrushEraseRef.current = false;
    return true;
  }, [inpaintElementMap]);

  const applyRectSelectionToElements = useCallback((start: { x: number; y: number }, end: { x: number; y: number }, mergeWithCurrent = false) => {
    if (!inpaintElementMap || !inpaintCanvasRef.current) return false;
    const canvas = inpaintCanvasRef.current;
    const sx = Math.max(0, Math.min(canvas.width - 1, start.x));
    const sy = Math.max(0, Math.min(canvas.height - 1, start.y));
    const ex = Math.max(0, Math.min(canvas.width - 1, end.x));
    const ey = Math.max(0, Math.min(canvas.height - 1, end.y));
    const minX = Math.max(0, Math.floor(Math.min(sx, ex) * inpaintElementMap.width / canvas.width));
    const minY = Math.max(0, Math.floor(Math.min(sy, ey) * inpaintElementMap.height / canvas.height));
    const maxX = Math.min(inpaintElementMap.width - 1, Math.ceil(Math.max(sx, ex) * inpaintElementMap.width / canvas.width));
    const maxY = Math.min(inpaintElementMap.height - 1, Math.ceil(Math.max(sy, ey) * inpaintElementMap.height / canvas.height));
    const selected = new Set<number>();
    for (let y = minY; y <= maxY; y++) {
      for (let x = minX; x <= maxX; x++) {
        const id = inpaintElementMap.idMap[y * inpaintElementMap.width + x];
        if (id > 0) selected.add(id);
      }
    }
    const next = Array.from(selected);
    if (next.length === 0) return false;
    if (!mergeWithCurrent) return setMaskFromElementIds(next);
    return setMaskFromElementIds(Array.from(new Set([...inpaintSelectedElementIds, ...next])));
  }, [inpaintElementMap, inpaintSelectedElementIds, setMaskFromElementIds]);

  useEffect(() => {
    if (!inpaintMode || !inpaintPreviewCanvasRef.current) return;
    const preview = inpaintPreviewCanvasRef.current;
    syncInpaintCanvasResolution(preview);
    const ctx = preview.getContext("2d");
    if (!ctx) return;
    ctx.clearRect(0, 0, preview.width, preview.height);
    if (!inpaintElementMap) return;
    const canvasW = Math.max(1, preview.width);
    const canvasH = Math.max(1, preview.height);
    const mapW = Math.max(1, inpaintElementMap.width);
    const mapH = Math.max(1, inpaintElementMap.height);
    const selectedSet = new Set(inpaintSelectedElementIds);
    const hoverId = inpaintHoverElementId && !selectedSet.has(inpaintHoverElementId) ? inpaintHoverElementId : null;

    const drawPixelMask = (elementId: number, fillStyle: string, alphaScale = 1) => {
      const bbox = getElementBounds(elementId);
      if (!bbox) return;
      const startX = Math.max(0, Math.floor((bbox.x / mapW) * canvasW));
      const endX = Math.min(canvasW - 1, Math.ceil(((bbox.x + bbox.width) / mapW) * canvasW) - 1);
      const startY = Math.max(0, Math.floor((bbox.y / mapH) * canvasH));
      const endY = Math.min(canvasH - 1, Math.ceil(((bbox.y + bbox.height) / mapH) * canvasH) - 1);
      ctx.fillStyle = fillStyle;
      for (let y = startY; y <= endY; y++) {
        const my = Math.max(0, Math.min(mapH - 1, Math.floor((y / canvasH) * mapH)));
        for (let x = startX; x <= endX; x++) {
          const mx = Math.max(0, Math.min(mapW - 1, Math.floor((x / canvasW) * mapW)));
          if (inpaintElementMap.idMap[my * mapW + mx] !== elementId) continue;
          ctx.globalAlpha = alphaScale;
          ctx.fillRect(x, y, 1, 1);
        }
      }
      ctx.globalAlpha = 1;
    };

    const drawBoundaryAnts = (elementId: number, color: string) => {
      const bbox = getElementBounds(elementId);
      if (!bbox) return;
      const startX = Math.max(0, Math.floor((bbox.x / mapW) * canvasW));
      const endX = Math.min(canvasW - 1, Math.ceil(((bbox.x + bbox.width) / mapW) * canvasW) - 1);
      const startY = Math.max(0, Math.floor((bbox.y / mapH) * canvasH));
      const endY = Math.min(canvasH - 1, Math.ceil(((bbox.y + bbox.height) / mapH) * canvasH) - 1);
      ctx.save();
      ctx.fillStyle = color;
      for (let y = startY; y <= endY; y++) {
        const my = Math.max(0, Math.min(mapH - 1, Math.floor((y / canvasH) * mapH)));
        let runStart = -1;
        for (let x = startX; x <= endX; x++) {
          const mx = Math.max(0, Math.min(mapW - 1, Math.floor((x / canvasW) * mapW)));
          if (inpaintElementMap.idMap[my * mapW + mx] === elementId) {
            const leftId = mx > 0 ? inpaintElementMap.idMap[my * mapW + (mx - 1)] : 0;
            const rightId = mx < mapW - 1 ? inpaintElementMap.idMap[my * mapW + (mx + 1)] : 0;
            const upId = my > 0 ? inpaintElementMap.idMap[(my - 1) * mapW + mx] : 0;
            const downId = my < mapH - 1 ? inpaintElementMap.idMap[(my + 1) * mapW + mx] : 0;
            const isBoundary = leftId !== elementId || rightId !== elementId || upId !== elementId || downId !== elementId;
            if (isBoundary) {
              if (runStart < 0) runStart = x;
            } else if (runStart >= 0) {
              ctx.fillRect(runStart, y, x - runStart, 1);
              runStart = -1;
            }
          } else if (runStart >= 0) {
            ctx.fillRect(runStart, y, x - runStart, 1);
            runStart = -1;
          }
        }
        if (runStart >= 0) {
          ctx.fillRect(runStart, y, endX - runStart + 1, 1);
        }
      }
      ctx.restore();
    };

    if (hoverId) {
      drawPixelMask(hoverId, "rgba(56, 189, 248, 0.18)");
      drawBoundaryAnts(hoverId, "rgba(56, 189, 248, 0.72)");
    }

    for (const id of inpaintSelectedElementIds) {
      drawPixelMask(id, "rgba(34, 211, 238, 0.22)");
      const bbox = getElementBounds(id);
      if (!bbox) continue;
      const boxX = (bbox.x / mapW) * canvasW;
      const boxY = (bbox.y / mapH) * canvasH;
      const boxW = (bbox.width / mapW) * canvasW;
      const boxH = (bbox.height / mapH) * canvasH;
      const ox = boxX + 0.5;
      const oy = boxY + 0.5;
      const ow = Math.max(1, boxW - 1);
      const oh = Math.max(1, boxH - 1);
      ctx.save();
      ctx.setLineDash([6, 5]);
      ctx.lineDashOffset = -inpaintAntsPhase;
      ctx.strokeStyle = "rgba(15, 23, 42, 0.95)";
      ctx.lineWidth = 1;
      ctx.strokeRect(ox, oy, ow, oh);
      ctx.lineDashOffset = -inpaintAntsPhase + 5;
      ctx.strokeStyle = "rgba(255,255,255,0.98)";
      ctx.strokeRect(ox, oy, ow, oh);
      ctx.restore();
    }

    if (inpaintSelectedElementIds.length > 0) {
      for (const id of inpaintSelectedElementIds) {
        drawBoundaryAnts(id, "rgba(34, 211, 238, 0.88)");
      }
    }

    if (inpaintRectSelecting && inpaintRectStart && inpaintRectEnd) {
      const x = Math.min(inpaintRectStart.x, inpaintRectEnd.x);
      const y = Math.min(inpaintRectStart.y, inpaintRectEnd.y);
      const w = Math.abs(inpaintRectEnd.x - inpaintRectStart.x);
      const h = Math.abs(inpaintRectEnd.y - inpaintRectStart.y);
      ctx.save();
      ctx.fillStyle = "rgba(56, 189, 248, 0.14)";
      ctx.fillRect(x, y, w, h);
      ctx.setLineDash([6, 5]);
      ctx.lineDashOffset = -inpaintAntsPhase;
      ctx.lineWidth = 1;
      ctx.strokeStyle = "rgba(15, 23, 42, 0.92)";
      ctx.strokeRect(x + 0.5, y + 0.5, Math.max(1, w - 1), Math.max(1, h - 1));
      ctx.lineDashOffset = -inpaintAntsPhase + 5;
      ctx.strokeStyle = "rgba(255,255,255,0.98)";
      ctx.strokeRect(x + 0.5, y + 0.5, Math.max(1, w - 1), Math.max(1, h - 1));
      ctx.restore();
    }
  }, [
    applyRectSelectionToElements,
    getElementBounds,
    inpaintAntsPhase,
    inpaintElementMap,
    inpaintHoverElementId,
    inpaintMode,
    inpaintRectEnd,
    inpaintRectSelecting,
    inpaintRectStart,
    inpaintSelectedElementIds,
    inpaintSmartMaskBase64,
    syncInpaintCanvasResolution,
  ]);

  const getInpaintCanvasPoint = useCallback((canvas: HTMLCanvasElement, clientX: number, clientY: number) => {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / Math.max(1, rect.width);
    const scaleY = canvas.height / Math.max(1, rect.height);
    const x = Math.max(0, Math.min(canvas.width - 1, (clientX - rect.left) * scaleX));
    const y = Math.max(0, Math.min(canvas.height - 1, (clientY - rect.top) * scaleY));
    return { x, y };
  }, []);

  const handleInpaintCanvasMouseDown = useCallback((e: React.MouseEvent<HTMLCanvasElement>) => {
    e.stopPropagation();
    const canvas = inpaintCanvasRef.current;
    if (!canvas) return;
    const point = getInpaintCanvasPoint(canvas, e.clientX, e.clientY);
    const wantsBrush = e.altKey || e.metaKey || e.ctrlKey;
    if (!wantsBrush) {
      const hitId = inpaintElementMap ? getInpaintElementIdAt(point.x, point.y) : null;
      const multiSelect = e.shiftKey || e.metaKey;
      const shiftClear = Boolean(e.shiftKey && !hitId && inpaintSmartMaskBase64);
      inpaintClickCandidateRef.current = { hitId, multiSelect, shiftClear };
      setInpaintRectSelecting(true);
      setInpaintRectStart(point);
      setInpaintRectEnd(point);
      return;
    }

    setInpaintDrawing(true);
    inpaintBrushEraseRef.current = Boolean(e.altKey && inpaintSmartMaskBase64);
    const newStroke = [point];
    inpaintCurrentStrokeRef.current = newStroke;
    setInpaintCurrentStroke(newStroke);
    const ctx = canvas.getContext("2d");
    if (!ctx || !inpaintMode) return;
    if (inpaintBrushEraseRef.current) {
      ctx.save();
      ctx.globalCompositeOperation = "destination-out";
      ctx.globalAlpha = 1;
      ctx.beginPath();
      ctx.arc(point.x, point.y, inpaintMode.brushSize, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    } else {
      ctx.save();
      ctx.globalCompositeOperation = "source-over";
      ctx.globalAlpha = 0.5;
      ctx.fillStyle = "#ff4444";
      ctx.beginPath();
      ctx.arc(point.x, point.y, inpaintMode.brushSize, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }, [
    clearInpaintStrokePixels,
    getInpaintCanvasPoint,
    getInpaintElementIdAt,
    inpaintElementMap,
    inpaintMode,
    inpaintSelectedElementIds,
    inpaintSmartMaskBase64,
    setMaskFromElementIds,
  ]);

  const handleInpaintCanvasMouseMove = useCallback((e: React.MouseEvent<HTMLCanvasElement>) => {
    const canvas = inpaintCanvasRef.current;
    if (!canvas) return;
    const point = getInpaintCanvasPoint(canvas, e.clientX, e.clientY);
    if (inpaintDrawing && inpaintMode) {
      e.stopPropagation();
      const prevPoints = inpaintCurrentStrokeRef.current;
      const lastPt = prevPoints.length > 0 ? prevPoints[prevPoints.length - 1] : point;
      const updatedStroke = [...prevPoints, point];
      inpaintCurrentStrokeRef.current = updatedStroke;
      setInpaintCurrentStroke(updatedStroke);

      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      if (inpaintBrushEraseRef.current) {
        ctx.save();
        ctx.globalCompositeOperation = "destination-out";
        ctx.globalAlpha = 1;
        ctx.lineWidth = inpaintMode.brushSize * 2;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        ctx.beginPath();
        ctx.moveTo(lastPt.x, lastPt.y);
        ctx.lineTo(point.x, point.y);
        ctx.stroke();
        ctx.restore();
      } else {
        ctx.save();
        ctx.globalCompositeOperation = "source-over";
        ctx.globalAlpha = 0.5;
        ctx.strokeStyle = "#ff4444";
        ctx.lineWidth = inpaintMode.brushSize * 2;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        ctx.beginPath();
        ctx.moveTo(lastPt.x, lastPt.y);
        ctx.lineTo(point.x, point.y);
        ctx.stroke();
        ctx.restore();
      }
      return;
    }

    if (inpaintRectSelecting) {
      setInpaintRectEnd(point);
      return;
    }
    if (!inpaintElementMap) {
      setInpaintHoverElementId(null);
      return;
    }
    setInpaintHoverElementId(getInpaintElementIdAt(point.x, point.y));
  }, [
    getInpaintCanvasPoint,
    getInpaintElementIdAt,
    inpaintDrawing,
    inpaintElementMap,
    inpaintMode,
    inpaintRectSelecting,
  ]);

  const finishInpaintBrushStroke = useCallback(() => {
    const currentStroke = inpaintCurrentStrokeRef.current;
    if (currentStroke.length > 0) {
      if (inpaintSmartMaskBase64) {
        const canvas = inpaintCanvasRef.current;
        if (canvas) {
          const maskBase64 = canvas.toDataURL("image/png");
          const cctx = canvas.getContext("2d");
          let active = 0;
          if (cctx) {
            const data = cctx.getImageData(0, 0, canvas.width, canvas.height).data;
            for (let i = 0; i < canvas.width * canvas.height; i++) {
              const pi = i * 4;
              if (data[pi + 3] > 0 && (data[pi] < 128 || data[pi + 1] < 128 || data[pi + 2] < 128)) {
                active++;
                if (active > 8) break;
              }
            }
          }
          setInpaintSmartMaskBase64(maskBase64);
          setInpaintMaskHasSelection(active > 0);
          setInpaintSelectedElementIds([]);
          setInpaintHoverElementId(null);
        }
      } else {
        setInpaintMode((prev) => (prev ? { ...prev, strokes: [...prev.strokes, currentStroke] } : prev));
      }
    }
    setInpaintDrawing(false);
    inpaintCurrentStrokeRef.current = [];
    setInpaintCurrentStroke([]);
    inpaintBrushEraseRef.current = false;
  }, [inpaintSmartMaskBase64]);

  const finishInpaintRectSelection = useCallback(() => {
    const start = inpaintRectStart;
    const end = inpaintRectEnd;
    const clickMeta = inpaintClickCandidateRef.current;
    inpaintClickCandidateRef.current = null;
    setInpaintRectSelecting(false);
    if (!start || !end) {
      setInpaintRectStart(null);
      setInpaintRectEnd(null);
      return;
    }
    const dragDistance = Math.hypot(end.x - start.x, end.y - start.y);
    const clickThreshold = 4;
    if (dragDistance <= clickThreshold) {
      if (!clickMeta) {
        setInpaintRectStart(null);
        setInpaintRectEnd(null);
        return;
      }

      if (clickMeta.shiftClear) {
        setInpaintSelectedElementIds([]);
        setInpaintSmartMaskBase64(null);
        setInpaintMaskHasSelection(false);
        setInpaintMode((prev) => (prev ? { ...prev, strokes: [] } : prev));
        clearInpaintStrokePixels();
        setInpaintRectStart(null);
        setInpaintRectEnd(null);
        return;
      }

      const hitId = clickMeta.hitId;
      if (hitId && hitId > 0) {
        const next = clickMeta.multiSelect
          ? (inpaintSelectedElementIds.includes(hitId)
            ? inpaintSelectedElementIds.filter((id) => id !== hitId)
            : [...inpaintSelectedElementIds, hitId])
          : [hitId];

        if (next.length === 0) {
          setInpaintSelectedElementIds([]);
          setInpaintSmartMaskBase64(null);
          setInpaintMaskHasSelection(false);
          setInpaintMode((prev) => (prev ? { ...prev, strokes: [] } : prev));
          clearInpaintStrokePixels();
        } else {
          setMaskFromElementIds(next);
        }
      } else if (!clickMeta.multiSelect) {
        setInpaintSelectedElementIds([]);
        setInpaintSmartMaskBase64(null);
        setInpaintMaskHasSelection(false);
        setInpaintMode((prev) => (prev ? { ...prev, strokes: [] } : prev));
        clearInpaintStrokePixels();
      }
      setInpaintRectStart(null);
      setInpaintRectEnd(null);
      return;
    }

    applyRectSelectionToElements(start, end, Boolean(clickMeta?.multiSelect));
    setInpaintRectStart(null);
    setInpaintRectEnd(null);
  }, [
    applyRectSelectionToElements,
    clearInpaintStrokePixels,
    inpaintRectEnd,
    inpaintRectStart,
    inpaintSelectedElementIds,
    setMaskFromElementIds,
  ]);

  const handleInpaintCanvasMouseUp = useCallback((e: React.MouseEvent<HTMLCanvasElement>) => {
    e.stopPropagation();
    if (inpaintDrawing) {
      finishInpaintBrushStroke();
      return;
    }
    if (inpaintRectSelecting) {
      finishInpaintRectSelection();
    }
  }, [
    finishInpaintBrushStroke,
    finishInpaintRectSelection,
    inpaintDrawing,
    inpaintRectSelecting,
  ]);

  const handleInpaintCanvasMouseLeave = useCallback((e: React.MouseEvent<HTMLCanvasElement>) => {
    e.stopPropagation();
    if (inpaintDrawing) {
      finishInpaintBrushStroke();
      return;
    }
    setInpaintHoverElementId(null);
    if (inpaintRectSelecting) {
      finishInpaintRectSelection();
    }
  }, [
    finishInpaintBrushStroke,
    finishInpaintRectSelection,
    inpaintDrawing,
    inpaintRectSelecting,
  ]);

  const handleInpaintCanvasWheel = useCallback((e: React.WheelEvent<HTMLCanvasElement>) => {
    if (!inpaintMode) return;
    e.preventDefault();
    e.stopPropagation();
    const step = e.shiftKey ? 4 : 2;
    const delta = e.deltaY < 0 ? step : -step;
    setInpaintMode((prev) => {
      if (!prev) return prev;
      const next = Math.max(2, Math.min(120, prev.brushSize + delta));
      return next === prev.brushSize ? prev : { ...prev, brushSize: next };
    });
  }, [inpaintMode]);

  const applySmartMask = useCallback(async (maskBase64: string) => {
    const canvas = inpaintCanvasRef.current;
    if (!canvas) return false;
    await new Promise<void>((resolve, reject) => {
      const image = new Image();
      image.onload = () => {
        const tmp = document.createElement("canvas");
        tmp.width = canvas.width;
        tmp.height = canvas.height;
        const tctx = tmp.getContext("2d");
        const overlayCtx = canvas.getContext("2d");
        if (!tctx || !overlayCtx) {
          reject(new Error("蒙版解析失败"));
          return;
        }
        tctx.drawImage(image, 0, 0, tmp.width, tmp.height);
        const data = tctx.getImageData(0, 0, tmp.width, tmp.height).data;
        const overlayImageData = overlayCtx.createImageData(tmp.width, tmp.height);
        const overlayPixels = overlayImageData.data;
        let active = 0;
        for (let i = 0; i < tmp.width * tmp.height; i++) {
          const pi = i * 4;
          const selected = data[pi + 3] > 0 && (data[pi] < 128 || data[pi + 1] < 128 || data[pi + 2] < 128);
          if (selected) {
            active++;
            overlayPixels[pi] = 255;
            overlayPixels[pi + 1] = 68;
            overlayPixels[pi + 2] = 68;
            overlayPixels[pi + 3] = 128;
          } else {
            overlayPixels[pi] = 0;
            overlayPixels[pi + 1] = 0;
            overlayPixels[pi + 2] = 0;
            overlayPixels[pi + 3] = 0;
          }
        }
        if (active === 0) {
          reject(new Error("未识别到可编辑区域"));
          return;
        }
        overlayCtx.clearRect(0, 0, canvas.width, canvas.height);
        overlayCtx.putImageData(overlayImageData, 0, 0);
        setInpaintSmartMaskBase64(maskBase64);
        setInpaintMaskHasSelection(true);
        setInpaintMode((prev) => (prev ? { ...prev, strokes: [] } : prev));
        setInpaintCurrentStroke([]);
        inpaintCurrentStrokeRef.current = [];
        inpaintBrushEraseRef.current = false;
        resolve();
      };
      image.onerror = () => reject(new Error("蒙版解析失败"));
      image.src = maskBase64;
    });
    return true;
  }, []);

  // Generate mask from inpaint strokes as base64 PNG (pure function, no deps)
  const generateInpaintMask = useCallback((imgW: number, imgH: number, strokes: { x: number; y: number }[][], brushSize: number) => {
    const canvas = document.createElement('canvas');
    canvas.width = imgW;
    canvas.height = imgH;
    const ctx = canvas.getContext('2d')!;
    // Fill with white (areas NOT to edit)
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, imgW, imgH);
    // Draw strokes in black (areas TO edit)
    ctx.fillStyle = '#000000';
    ctx.strokeStyle = '#000000';
    for (const stroke of strokes) {
      if (stroke.length < 2) {
        // Single point — draw a circle
        ctx.beginPath();
        ctx.arc(stroke[0].x, stroke[0].y, brushSize / 2, 0, Math.PI * 2);
        ctx.fill();
      } else {
        ctx.lineWidth = brushSize;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.beginPath();
        ctx.moveTo(stroke[0].x, stroke[0].y);
        for (let i = 1; i < stroke.length; i++) {
          ctx.lineTo(stroke[i].x, stroke[i].y);
        }
        ctx.stroke();
      }
    }
    return canvas.toDataURL('image/png');
  }, []);


  // ─── Undo helper ───
  const pushUndo = useCallback(() => {
    const snapshot = canvasImagesRef.current.map((img) => ({ ...img }));
    setUndoStack((prev) => [...prev.slice(-30), snapshot]);
    setRedoStack([]);
  }, []);

  // ─── Find next non-overlapping position ───
  const findNonOverlappingPosition = useCallback(
    (x: number, y: number, w: number, h: number, excludeId?: string) => {
      const GAP = 24;
      let tryX = x;
      let tryY = y;

      const overlaps = (tx: number, ty: number) =>
        canvasImages.some((img) => {
          if (img.id === excludeId) return false;
          const display = getCanvasImageDisplaySize(img);
          return (
            tx < img.canvas_x + display.w + GAP &&
            tx + w + GAP > img.canvas_x &&
            ty < img.canvas_y + display.h + GAP &&
            ty + h + GAP > img.canvas_y
          );
        });

      if (!overlaps(tryX, tryY)) return { x: tryX, y: tryY };

      // Grid-aligned search: prefer rightward, then downward (new row)
      // This ensures multiple placeholders align neatly
      const stepX = w + GAP;
      const stepY = h + GAP;

      // First try rightward from the same row
      for (let col = 1; col <= 10; col++) {
        tryX = x + col * stepX;
        if (!overlaps(tryX, y)) return { x: tryX, y };
      }

      // Then try downward rows (left-aligned with original position)
      for (let row = 1; row <= 10; row++) {
        tryY = y + row * stepY;
        if (!overlaps(x, tryY)) return { x, y: tryY };
        // Try rightward in this row
        for (let col = 1; col <= 10; col++) {
          tryX = x + col * stepX;
          if (!overlaps(tryX, tryY)) return { x: tryX, y: tryY };
        }
      }

      // Fallback: also try upward rows
      for (let row = 1; row <= 5; row++) {
        tryY = y - row * stepY;
        if (tryY < 20) continue;
        if (!overlaps(x, tryY)) return { x, y: tryY };
        for (let col = 1; col <= 10; col++) {
          tryX = x + col * stepX;
          if (!overlaps(tryX, tryY)) return { x: tryX, y: tryY };
        }
      }

      return { x, y };
    },
    [canvasImages, getCanvasImageDisplaySize]
  );

  // ─── Get viewport center in canvas coordinates ───
  const getViewportCenter = useCallback(() => {
    const container = document.getElementById('canvas-container');
    if (!container) return { x: 100, y: 100 };
    const rect = container.getBoundingClientRect();
    const screenCenterX = rect.width / 2;
    const screenCenterY = rect.height / 2;
    const scale = canvasScaleRef.current;
    const offset = canvasOffsetRef.current;
    const canvasX = (screenCenterX - offset.x) / scale;
    const canvasY = (screenCenterY - offset.y) / scale;
    return { x: canvasX, y: canvasY };
  }, []);

  // ─── Find best position adjacent to the image cluster (not far away) ───
  // Returns { x, y } in canvas coordinates, next to existing images but not overlapping
  const getImageClusterPosition = useCallback((imgW: number, imgH: number) => {
    const GAP = 16;
    const existing = canvasImagesRef.current.filter((img) => !img.isGenerating && !img.isUploading);

    // No existing images — fall back to viewport center
    if (existing.length === 0) {
      const vc = getViewportCenter();
      return { x: vc.x - imgW / 2, y: vc.y - imgH / 2 };
    }

    // Find bounding box of the image cluster
    const clusterMinX = existing.reduce((m, img) => Math.min(m, img.canvas_x), Infinity);
    const clusterMinY = existing.reduce((m, img) => Math.min(m, img.canvas_y), Infinity);
    const clusterMaxX = existing.reduce((m, img) => Math.max(m, img.canvas_x + getCanvasImageDisplaySize(img).w), -Infinity);
    const clusterMaxY = existing.reduce((m, img) => Math.max(m, img.canvas_y + getCanvasImageDisplaySize(img).h), -Infinity);

    const overlaps = (tx: number, ty: number) =>
      canvasImagesRef.current.some((img) => {
        const display = getCanvasImageDisplaySize(img);
        return (
        tx < img.canvas_x + display.w + GAP &&
        tx + imgW + GAP > img.canvas_x &&
        ty < img.canvas_y + display.h + GAP &&
        ty + imgH + GAP > img.canvas_y
        );
      });

    // Strategy: try positions around the cluster edges, preferring right → bottom → left → top
    const candidates = [
      // Right of cluster, aligned with top
      { x: clusterMaxX + GAP, y: clusterMinY },
      // Right of cluster, aligned with bottom
      { x: clusterMaxX + GAP, y: clusterMaxY - imgH },
      // Below cluster, aligned with left
      { x: clusterMinX, y: clusterMaxY + GAP },
      // Below cluster, aligned with right
      { x: clusterMaxX - imgW, y: clusterMaxY + GAP },
      // Left of cluster, aligned with top
      { x: clusterMinX - imgW - GAP, y: clusterMinY },
      // Above cluster, aligned with left
      { x: clusterMinX, y: clusterMinY - imgH - GAP },
    ];

    for (const c of candidates) {
      if (c.x >= 0 && c.y >= 0 && !overlaps(c.x, c.y)) {
        return c;
      }
    }

    // If all edge positions overlap, do a spiral search starting from cluster center-right
    const startX = clusterMaxX + GAP;
    const startY = clusterMinY;
    for (let radius = 1; radius <= 50; radius++) {
      for (let dx = -radius; dx <= radius; dx++) {
        for (let dy = -radius; dy <= radius; dy++) {
          if (Math.abs(dx) !== radius && Math.abs(dy) !== radius) continue;
          const tryX = startX + dx * (imgW + GAP);
          const tryY = startY + dy * (imgH + GAP);
          if (tryX >= 0 && tryY >= 0 && !overlaps(tryX, tryY)) {
            return { x: tryX, y: tryY };
          }
        }
      }
    }

    // Fallback
    return { x: clusterMaxX + GAP, y: clusterMinY };
  }, [getViewportCenter, getCanvasImageDisplaySize]);

  // ─── Pan canvas so the given canvas position is centered in viewport ───
  const panCanvasToPosition = useCallback((canvasX: number, canvasY: number, imgW?: number, imgH?: number) => {
    const container = document.getElementById('canvas-container');
    if (!container) return;
    const rect = container.getBoundingClientRect();
    const screenCenterX = rect.width / 2;
    const screenCenterY = rect.height / 2;
    const offsetX = imgW ? imgW / 2 : 0;
    const offsetY = imgH ? imgH / 2 : 0;
    const scale = canvasScaleRef.current;
    setCanvasOffset({
      x: screenCenterX - (canvasX + offsetX) * scale,
      y: screenCenterY - (canvasY + offsetY) * scale,
    });
  }, []);

