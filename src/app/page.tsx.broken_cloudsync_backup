          return res.ok && Array.isArray(data.versions) ? data.versions as AssetVersion[] : [];
        })),
      ]);

      const operationMap = new Map<string, DesignOperation>();
      operationGroups.flat().forEach((operation) => operationMap.set(operation.id, operation));
      const versionMap = new Map<string, AssetVersion>();
      versionGroups.flat().forEach((version) => versionMap.set(version.id, version));

      setAssetHistory({
        imageId: target.id,
        assets,
        operations: Array.from(operationMap.values()).sort((a, b) => new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime()),
        versions: Array.from(versionMap.values()).sort((a, b) => (b.version_index || 0) - (a.version_index || 0)),
      });
    } catch (err) {
