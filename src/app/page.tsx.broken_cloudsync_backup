                          <circle cx="8.5" cy="8.5" r="1.5"/>
                          <path d="m21 15-5-5L5 21"/>
                          <line x1="3" y1="21" x2="21" y2="3" stroke="currentColor" strokeWidth="1.5" opacity="0.5"/>
                        </svg>
                        <span className="text-[10px] text-muted-foreground mb-1">图片加载失败</span>
                        <button
                          className="text-[10px] text-primary hover:text-primary/80 mt-1"
                          onClick={(e) => {
                            e.stopPropagation();
                            setImgLoadFailed(prev => { const n = new Set(prev); n.delete(img.id); return n; });
                          }}
                        >
                          点击重试
                        </button>
                      </div>
                    ) : (
                      <img
	                        src={img.image_url}
	                        alt={img.prompt}
	                        className="w-full h-full object-cover cursor-default"
                        style={filterPanelImageId === img.id ? { filter: buildCssImageFilter(filterDraft) } : img.filters ? { filter: buildCssImageFilter(img.filters) } : undefined}
                        draggable={false}
                        key={img.id + (imgLoadFailed.has(img.id) ? '-retry' : '')}
                        onError={() => {
                          setImgLoadFailed(prev => new Set(prev).add(img.id));
                        }}
                        onClick={(e) => {
                          e.stopPropagation();
                        }}
                        onLoad={(e) => {
                          const natW = e.currentTarget.naturalWidth;
                          const natH = e.currentTarget.naturalHeight;
                          handleCanvasNaturalSize(img, natW, natH);
                        }}
                      />
                    )}
                  </div>

                  {/* Inpaint mask canvas overlay */}
                  {inpaintMode && inpaintMode.imageId === img.id && (() => {
                    // Calculate object-contain position to align canvas with rendered image area
                    const orig = imgOrigSizeRef.current[img.id];
                    const natW = orig?.w || img.canvas_width;
                    const natH = orig?.h || img.canvas_height;
                    const containerW = img.canvas_width;
                    const containerH = img.canvas_height;
                    const imgRatio = natW / natH;
                    const containerRatio = containerW / containerH;
                    let renderW: number, renderH: number, offsetX = 0, offsetY = 0;
                    if (imgRatio > containerRatio) {
                      renderW = containerW; renderH = containerW / imgRatio;
                      offsetX = 0; offsetY = (containerH - renderH) / 2;
                    } else {
                      renderH = containerH; renderW = containerH * imgRatio;
                      offsetX = (containerW - renderW) / 2; offsetY = 0;
                    }
                    return (
                    <div className="absolute z-30 border-2 border-border-secondary rounded-lg"
                      style={{ left: offsetX, top: offsetY, width: renderW, height: renderH }}>
