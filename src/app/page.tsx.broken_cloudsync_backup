  // ─── Canvas drag handlers ───
  const handleCanvasMouseDown = (e: React.MouseEvent) => {
    if ((e.target as HTMLElement).closest(".canvas-image-item")) return;

    // Click on empty canvas while in expand mode: cancel expand
    if (expandMode && e.button === 0) {
      cancelExpand();
      return;
    }

    // Space+left click, middle click, right click, or Alt+left click: pan canvas
    if (e.button === 1 || e.button === 2 || (e.button === 0 && (e.altKey || spaceHeld))) {
      setIsDraggingCanvas(true);
      setDragStart({ x: e.clientX - canvasOffset.x, y: e.clientY - canvasOffset.y });
      return;
    }

    // Left click on empty canvas: start box selection
    if (e.button === 0) {
      // Close prompt library / skill panel when clicking canvas blank area
      if (showPromptLibrary) setShowPromptLibrary(false);
      if (showSkillPanel) setShowSkillPanel(false);
      const container = canvasContainerRef.current;
      if (container) {
        const rect = container.getBoundingClientRect();
        const x = (e.clientX - rect.left - canvasOffset.x) / canvasScale;
        const y = (e.clientY - rect.top - canvasOffset.y) / canvasScale;
        setBoxSelectStart({ x, y });
        setBoxSelectEnd({ x, y });
        setIsBoxSelecting(true);
      }
      // Click on empty canvas clears selection unless Shift is held
      if (!e.shiftKey) {
        selectedImageIdsRef.current = [];
        selectedImageIdRef.current = null;
        setSelectedImageIds([]);
        setSelectedImageId(null);
      }
    }
  };

  const handleCanvasMouseMove = (e: React.MouseEvent) => {
    // Pan canvas (right/middle/alt drag)
