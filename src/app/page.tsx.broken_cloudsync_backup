  const handleImageMouseMove = useCallback(
    (e: React.MouseEvent) => {
      if (!draggingImageId || !canvasContainerRef.current) return;

      const container = canvasContainerRef.current.getBoundingClientRect();
      const rawX = (e.clientX - container.left - canvasOffset.x) / canvasScale - imageDragOffset.x / canvasScale;
      const rawY = (e.clientY - container.top - canvasOffset.y) / canvasScale - imageDragOffset.y / canvasScale;
      const draggedImg = canvasImages.find((i) => i.id === draggingImageId);
      const display = draggedImg ? getCanvasImageDisplaySize(draggedImg) : { w: 320, h: 320 };
      const w = display.w;
      const h = display.h;

      const snapped = snapPosition(rawX, rawY, w, h, draggingImageId);
      setSnapLines({ x: snapped.linesX, y: snapped.linesY });

      // Calculate delta from original position
      const dx = snapped.x - (draggedImg?.canvas_x || 0);
      const dy = snapped.y - (draggedImg?.canvas_y || 0);

      setCanvasImages((prev) =>
        prev.map((img) => {
          // Move all selected images together
          if (selectedImageIds.includes(img.id) && selectedImageIds.length > 1) {
            return { ...img, canvas_x: img.canvas_x + dx, canvas_y: img.canvas_y + dy };
          }
          if (img.id === draggingImageId) {
            return { ...img, canvas_x: snapped.x, canvas_y: snapped.y };
          }
          return img;
        })
      );
    },
    [draggingImageId, canvasOffset, canvasScale, imageDragOffset, canvasImages, snapPosition, selectedImageIds, getCanvasImageDisplaySize]
  );

