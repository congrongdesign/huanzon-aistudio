            const scaleRatio = newScale / canvasScaleRef.current;
            const newOffset = {
              x: focusX - (focusX - canvasOffsetRef.current.x) * scaleRatio,
              y: focusY - (focusY - canvasOffsetRef.current.y) * scaleRatio,
            };
            setCanvasOffset(newOffset);
            setCanvasScale(newScale);
