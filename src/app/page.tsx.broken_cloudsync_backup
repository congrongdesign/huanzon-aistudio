          apiKey,
          baseUrl,
          model: effectiveModel,
          imageSize: isNodeNanoBanana ? imageResolution : undefined,
          projectId: effectiveProjectId,
          referenceImages: referenceList.length > 0 ? referenceList : undefined,
        }),
        signal: abortController.signal,
      });

      const data = await res.json();
      if (!res.ok) {
        const error = data?.error || "节点生图失败";
        setCanvasImages((prev) => prev.map((img) => img.id === placeholderId ? { ...img, status: "failed", isGenerating: false, prompt: `${prompt}\n${error}` } : img));
        canvasImagesRef.current = canvasImagesRef.current.map((img) => img.id === placeholderId ? { ...img, status: "failed", isGenerating: false, prompt: `${prompt}\n${error}` } : img);
        return { ok: false, error };
      }

      const newSizeStr = data.size || sizeStr || "1:1";
      let finalW = displayW;
      let finalH = displayH;
      if (newSizeStr.includes("x")) {
        const [pw, ph] = newSizeStr.split("x").map(Number);
        if (pw && ph) {
          const ratio = pw / ph;
          if (ratio >= 1) {
            finalW = 320;
            finalH = Math.round(320 / ratio);
          } else {
            finalH = 320;
            finalW = Math.round(320 * ratio);
          }
        }
      }

      const newImage: CanvasImage = {
        ...data,
        canvas_x: Math.round(placeholder.canvas_x + (placeholder.canvas_width - finalW) / 2),
        canvas_y: Math.round(placeholder.canvas_y + (placeholder.canvas_height - finalH) / 2),
        canvas_width: finalW,
        canvas_height: finalH,
        isGenerating: false,
      };

      setCanvasImages((prev) => prev.map((img) => img.id === placeholderId ? newImage : img));
      canvasImagesRef.current = canvasImagesRef.current.map((img) => img.id === placeholderId ? newImage : img);
      fetch("/api/history", {
        method: "PATCH",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify({
          id: data.id,
          canvas_x: newImage.canvas_x,
          canvas_y: newImage.canvas_y,
          canvas_width: newImage.canvas_width,
          canvas_height: newImage.canvas_height,
        }),
      }).catch(() => {});

      return { ok: true, image: newImage };
    } catch (err) {
      if (err instanceof DOMException && err.name === "AbortError") {
        return { ok: false, error: "生成已取消" };
      }
      const error = err instanceof Error ? err.message : "节点生图失败";
      setCanvasImages((prev) => prev.map((img) => img.id === placeholderId ? { ...img, status: "failed", isGenerating: false, prompt: `${prompt}\n${error}` } : img));
      canvasImagesRef.current = canvasImagesRef.current.map((img) => img.id === placeholderId ? { ...img, status: "failed", isGenerating: false, prompt: `${prompt}\n${error}` } : img);
      return { ok: false, error };
    } finally {
      generateAbortControllers.current.delete(placeholderId);
    }
  }, [
    apiKey,
    baseUrl,
    currentProjectId,
    imageModel,
    imageSize,
    stylePreset,
