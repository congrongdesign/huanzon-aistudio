    const startDate = new Date(today.getTime() - (83 + dayOfWeek) * 86400000);
    let currentWeek: { date: string; count: number; isToday: boolean; isFuture: boolean; month: number }[] = [];
    for (let i = 0; i < 84 + dayOfWeek; i++) {
