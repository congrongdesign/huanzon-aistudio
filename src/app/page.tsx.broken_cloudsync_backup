function buildAiEditPrompt(instruction: string, preserveStrength: AiEditDialogState["preserveStrength"], variantIndex: number, totalVariants: number) {
  const preserveRule = preserveStrength === "strict"
    ? "Strictly preserve the original subject identity, composition, perspective, text, logos, proportions, and all important details. Only change what the user explicitly asks."
    : preserveStrength === "creative"
      ? "Preserve the main subject and intent, but allow tasteful visual exploration in lighting, mood, color, background, and design treatment."
      : "Preserve the subject identity, composition, proportions, and key details, while improving the requested visual direction naturally.";
  const variantRule = totalVariants > 1
    ? `Create candidate ${variantIndex + 1} of ${totalVariants}. Make it meaningfully different from the other candidates while following the same user instruction.`
    : "Create one polished final image.";
  return [
    "Image editing task.",
    preserveRule,
    variantRule,
    "Do not output explanatory text. Return one clean final image only.",
    `User instruction: ${instruction}`,
  ].join("\n");
}

function splitFailedPromptDetail(prompt: string) {
  const [task = "", ...rest] = prompt.split("\n");
  return {
    task: task.trim() || "生成任务",
    detail: rest.join("\n").trim(),
  };
}

function appendPromptSuffix(prompt: string, suffix?: string | null) {
  const cleanPrompt = prompt.trim();
  const cleanSuffix = (suffix || "").trim();
  if (!cleanSuffix) return cleanPrompt;
  return `${cleanPrompt}\n\nStyle direction: ${cleanSuffix}`;
}

