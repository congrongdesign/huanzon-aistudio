        ] as const).map(mode => (
          <button
            key={mode.key}
            data-ui-nav-btn="true"
            data-ui-nav-kind={mode.key}
            data-active={((galleryOpen && mode.key === 'gallery') || (!galleryOpen && navMode === mode.key)) ? "true" : "false"}
