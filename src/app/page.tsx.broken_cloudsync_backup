    e.stopPropagation();
    mouseDownPosRef.current = { x: e.clientX, y: e.clientY };
    // If in expand mode and clicking a different image, cancel expand first
    if (expandMode && expandMode.imageId !== img.id) {
      cancelExpand();
    }

    // Multi-select: Shift+click toggles selection
    if (e.shiftKey) {
      const currentIds = selectedImageIdsRef.current;
      const isSelected = currentIds.includes(img.id);
      const nextIds = isSelected ? currentIds.filter((id) => id !== img.id) : [...currentIds, img.id];
      const nextPrimary = isSelected ? (nextIds[0] ?? null) : img.id;
      selectedImageIdsRef.current = nextIds;
      selectedImageIdRef.current = nextPrimary;
      setSelectedImageIds(nextIds);
      setSelectedImageId(nextPrimary);
    } else {
      selectedImageIdsRef.current = [img.id];
      selectedImageIdRef.current = img.id;
      setSelectedImageIds([img.id]);
      setSelectedImageId(img.id);
    }
    setDraggingImageId(img.id);
    const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
    setImageDragOffset({
      x: e.clientX - rect.left,
      y: e.clientY - rect.top,
