  // ─── Expand ratio presets ───
  const getExpandRatioPresets = useCallback(() => {
    if (!expandMode) return [];
    const img = canvasImages.find((i) => i.id === expandMode.imageId);
    if (!img) return [];
    const er = expandMode;
    const origW = img.canvas_width;
    const origH = img.canvas_height;
    const totalW = er.expandLeft + origW + er.expandRight;
    const totalH = er.expandTop + origH + er.expandBottom;

    const presets: { label: string; eL: number; eT: number; eR: number; eB: number }[] = [];
    const ratios = [
      { label: "1:1", w: 1, h: 1 },
      { label: "4:5", w: 4, h: 5 },
      { label: "3:4", w: 3, h: 4 },
      { label: "2:3", w: 2, h: 3 },
      { label: "9:16", w: 9, h: 16 },
      { label: "3:2", w: 3, h: 2 },
      { label: "4:3", w: 4, h: 3 },
      { label: "16:9", w: 16, h: 9 },
      { label: "21:9", w: 21, h: 9 },
      { label: "2:1", w: 2, h: 1 },
    ];
    for (const r of ratios) {
      const targetW = r.w >= r.h ? Math.max(origW, origH * r.w / r.h) : origH * r.w / r.h;
      const targetH = r.h >= r.w ? Math.max(origH, origW * r.h / r.w) : origW * r.h / r.w;
      if (Math.abs(targetW - origW) < 5 && Math.abs(targetH - origH) < 5) continue;
      presets.push({
        label: r.label,
        eL: Math.max(0, (targetW - origW) / 2),
        eT: Math.max(0, (targetH - origH) / 2),
        eR: Math.max(0, (targetW - origW) / 2),
        eB: Math.max(0, (targetH - origH) / 2),
      });
    }
    return presets;
  }, [expandMode, canvasImages]);

  const applyExpandPreset = useCallback((preset: { eL: number; eT: number; eR: number; eB: number }) => {
    if (!expandMode) return;
    setExpandMode({ ...expandMode, expandLeft: preset.eL, expandTop: preset.eT, expandRight: preset.eR, expandBottom: preset.eB, imageOffsetX: 0, imageOffsetY: 0 });
  }, [expandMode]);

  // ─── Expand handle drag ───
  const expandDraggingRef = useRef<{ handle: string; startX: number; startY: number; startExpand: { expandLeft: number; expandRight: number; expandTop: number; expandBottom: number } } | null>(null);
  // ─── Expand image-in-frame drag ───
  const expandImageDragRef = useRef<{ startX: number; startY: number; startOffsetX: number; startOffsetY: number } | null>(null);

  const handleExpandMouseDown = useCallback((e: React.MouseEvent, handle: string) => {
    e.preventDefault();
    e.stopPropagation();
    if (!expandMode) return;
    expandDraggingRef.current = { handle, startX: e.clientX, startY: e.clientY, startExpand: { expandLeft: expandMode.expandLeft, expandRight: expandMode.expandRight, expandTop: expandMode.expandTop, expandBottom: expandMode.expandBottom } };
  }, [expandMode]);

  const handleExpandImageDragStart = useCallback((e: React.MouseEvent) => {
    e.preventDefault();
    e.stopPropagation();
    if (!expandMode) return;
    expandImageDragRef.current = { startX: e.clientX, startY: e.clientY, startOffsetX: expandMode.imageOffsetX, startOffsetY: expandMode.imageOffsetY };
  }, [expandMode]);

  useEffect(() => {
    if (!expandMode) return;
    const handleMove = (e: MouseEvent) => {
      // Handle expand border drag
      if (expandDraggingRef.current) {
        const { handle, startX, startY, startExpand } = expandDraggingRef.current;
        const dx = (e.clientX - startX) / canvasScale;
        const dy = (e.clientY - startY) / canvasScale;
        setExpandMode((prev) => {
          if (!prev) return prev;
          const ne = { ...startExpand };
          if (handle.includes("l")) ne.expandLeft = Math.max(0, startExpand.expandLeft - dx);
          if (handle.includes("r")) ne.expandRight = Math.max(0, startExpand.expandRight + dx);
          if (handle.includes("t")) ne.expandTop = Math.max(0, startExpand.expandTop - dy);
          if (handle.includes("b")) ne.expandBottom = Math.max(0, startExpand.expandBottom + dy);
          return { ...prev, ...ne };
        });
      }
      // Handle image-in-frame drag
      if (expandImageDragRef.current) {
        const { startX, startY, startOffsetX, startOffsetY } = expandImageDragRef.current;
        const dx = (e.clientX - startX) / canvasScale;
        const dy = (e.clientY - startY) / canvasScale;
        setExpandMode((prev) => {
          if (!prev) return prev;
          // Clamp image offset within the frame
          const img = canvasImages.find(i => i.id === prev.imageId);
          if (!img) return prev;
          const totalW = img.canvas_width + prev.expandLeft + prev.expandRight;
          const totalH = img.canvas_height + prev.expandTop + prev.expandBottom;
          const maxOffX = prev.expandLeft;
          const maxOffY = prev.expandTop;
          const minOffX = -(prev.expandRight);
          const minOffY = -(prev.expandBottom);
          const newOX = Math.max(minOffX, Math.min(maxOffX, startOffsetX + dx));
          const newOY = Math.max(minOffY, Math.min(maxOffY, startOffsetY + dy));
          return { ...prev, imageOffsetX: newOX, imageOffsetY: newOY };
        });
      }
    };
    const handleUp = () => { expandDraggingRef.current = null; expandImageDragRef.current = null; };
    window.addEventListener("mousemove", handleMove);
    window.addEventListener("mouseup", handleUp);
    return () => { window.removeEventListener("mousemove", handleMove); window.removeEventListener("mouseup", handleUp); };
  }, [expandMode, canvasScale, canvasImages]);

  // ─── Image resize handle drag ───
  useEffect(() => {
    if (!resizingImageId || !resizeStart) return;
    const handleMove = (e: MouseEvent) => {
      const dx = (e.clientX - resizeStart.mx) / canvasScale;
      const dy = (e.clientY - resizeStart.my) / canvasScale;
