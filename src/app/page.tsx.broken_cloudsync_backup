  useEffect(() => {
    if (!currentProjectId) return;
    const POLL_INTERVAL = 5000;
    let active = true;

    const poll = async () => {
      if (!active) return;
      try {
        // Poll new images — only add images we don't already have
        const imgRes = await fetch(`/api/history?projectId=${currentProjectId}&pageSize=100`, { headers: { ...getAuthHeaders() } });
        if (!active) return;
        if (imgRes.ok) {
          const imgData = await imgRes.json();
          const remoteRecords: CanvasImage[] = imgData.records || [];
          // Build a set of ALL current image IDs (including placeholders that have been replaced with real IDs)
          const currentIds = new Set(canvasImagesRef.current.map(i => i.id));
          // Also track generating placeholders for replacement (by prompt, preserving order)
          const generatingPlaceholders = canvasImagesRef.current
            .map((ci, idx) => ({ ci, idx }))
            .filter(({ ci }) => ci.isGenerating);
          const newImages = remoteRecords.filter((r: CanvasImage) => !currentIds.has(r.id));
          if (newImages.length > 0) {
            setCanvasImages(prev => {
              const existingIds = new Set(prev.map(i => i.id));
              let toAdd = newImages.filter((r: CanvasImage) => !existingIds.has(r.id));
              if (toAdd.length === 0) return prev;

              // For each new image, check if there's a generating placeholder with the same prompt
              // If so, replace the placeholder instead of adding a duplicate
              // Use a Set to track which placeholders have already been matched
              const matchedPlaceholderIds = new Set<string>();
              const updatedPrev = [...prev];
              toAdd = toAdd.filter((newImg: CanvasImage) => {
                // Find first unmatched placeholder with the same prompt
                const placeholderIdx = updatedPrev.findIndex(
                  (ci) => ci.isGenerating && ci.prompt === newImg.prompt && !matchedPlaceholderIds.has(ci.id)
                );
                if (placeholderIdx >= 0) {
                  // Only replace placeholder if the DB record is actually completed with a valid image URL
                  // Otherwise keep the generating placeholder (avoid replacing with incomplete data)
                  if (newImg.status === 'completed' && newImg.image_url) {
                    const placeholder = updatedPrev[placeholderIdx];
                    matchedPlaceholderIds.add(placeholder.id);
                    updatedPrev[placeholderIdx] = {
                      ...newImg,
                      canvas_x: placeholder.canvas_x,
                      canvas_y: placeholder.canvas_y,
                      canvas_width: placeholder.canvas_width,
                      canvas_height: placeholder.canvas_height,
                      isGenerating: false,
                    };
                  } else if (newImg.status === 'failed') {
                    // Mark the placeholder as failed instead
                    const placeholder = updatedPrev[placeholderIdx];
                    matchedPlaceholderIds.add(placeholder.id);
                    updatedPrev[placeholderIdx] = {
                      ...placeholder,
                      status: 'failed',
                      isGenerating: false,
                      id: newImg.id || placeholder.id,
                    };
                  }
                  // For 'pending'/'generating' status, keep the generating placeholder as-is
                  return false; // Don't add as new — already replaced the placeholder
                }
                return true; // No matching placeholder, add as new
              });

              if (toAdd.length === 0) return updatedPrev;
              // Only add images that are completed with valid URLs (skip pending/failed without placeholders)
              const validToAdd = toAdd.filter((r: CanvasImage) => r.status === 'completed' && r.image_url);
              if (validToAdd.length === 0) return updatedPrev;
              // Dedup
              const seen = new Set(updatedPrev.map(i => i.id));
              const unique = validToAdd.filter((r: CanvasImage) => !seen.has(r.id));
              if (unique.length === 0) return updatedPrev;
              const finalImages = [...unique, ...updatedPrev];
              canvasImagesRef.current = finalImages;
              return finalImages;
            });
          }
          // Remove images that were deleted remotely
          const remoteIds = new Set(remoteRecords.map((r: CanvasImage) => r.id));
          const locallyOnly = canvasImagesRef.current.filter(i => !i.isGenerating && !i.is_reference && !remoteIds.has(i.id));
          if (locallyOnly.length > 0) {
            const removeIds = new Set(locallyOnly.map(i => i.id));
            setCanvasImages(prev => prev.filter(i => !removeIds.has(i.id)));
          }
        }

        // Poll new messages
        const msgRes = await fetch(`/api/chat?projectId=${currentProjectId}`, { headers: { ...getAuthHeaders() } });
        if (!active) return;
        if (msgRes.ok) {
          const msgData = await msgRes.json();
