  // ─── Download image ───
  const downloadImage = async (url: string, filename: string) => {
    if (!url) {
      setActionToast("图片地址为空，无法下载");
      setTimeout(() => setActionToast(null), 1800);
      return;
    }
    const safeName = filename.replace(/[\\/:*?"<>|]+/g, "-") || `image-${Date.now()}.png`;
    const triggerDownload = (href: string, target?: "_blank") => {
      const a = document.createElement("a");
      a.href = href;
      a.download = safeName;
      if (target) a.target = target;
      a.rel = "noopener";
      a.style.display = "none";
      document.body.appendChild(a);
      a.click();
      a.remove();
    };

    try {
      const canSaveToLocalDirectory = Boolean(downloadDirectory.trim()) && !(url.startsWith("data:") || url.startsWith("blob:"));

      if (canSaveToLocalDirectory) {
        const res = await fetch("/api/save-image-download", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url, filename: safeName }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(data?.error || "保存图片失败");
        }
        const location = typeof data?.filePath === "string" ? data.filePath : downloadDirectory.trim();
        setActionToast(`图片已保存到 ${location}`);
        setTimeout(() => setActionToast(null), 2600);
        return;
      }

      if (url.startsWith("data:") || url.startsWith("blob:")) {
        triggerDownload(url);
      } else {
        const downloadUrl = `/api/download-image?url=${encodeURIComponent(url)}&filename=${encodeURIComponent(safeName)}&t=${Date.now()}`;
        triggerDownload(downloadUrl);
      }
      const fallbackMessage = downloadDirectory.trim()
        ? "已切换为浏览器下载，请按浏览器提示保存"
        : "图片已开始下载，请按浏览器提示保存";
      setActionToast(fallbackMessage);
      setTimeout(() => setActionToast(null), 2000);
    } catch (error) {
      try {
        triggerDownload(url, "_blank");
        setActionToast(error instanceof Error ? `已打开原图，请手动保存：${error.message}` : "已打开原图，请手动保存");
        setTimeout(() => setActionToast(null), 2600);
      } catch {
        setActionToast("下载失败，请稍后重试");
