      setAssetHistoryError(message);
      setActionToast(message);
      setTimeout(() => setActionToast(null), 2600);
    } finally {
      setRestoringVersionId(null);
    }
  }, [assetHistory?.imageId, findNonOverlappingPosition, getImageClusterPosition, loadAssetHistory, panCanvasToPosition, pushUndo, restoringVersionId]);

  // ─── Auto-arrange all images (no overlap) ───
  const autoArrangeCanvas = useCallback(() => {
    if (canvasImages.length === 0) return;
    const GAP = 20;
    const PADDING = 40;
    const GROUP_GAP = 40;

    // Get visible canvas area to determine layout
    const container = canvasContainerRef.current;
    let viewWidth = 1200;
    let viewHeight = 800;
    if (container) {
      const rect = container.getBoundingClientRect();
      viewWidth = rect.width / canvasScale;
      viewHeight = rect.height / canvasScale;
    }

    // Group images by batch (creation time proximity) and type (generated vs reference)
    const now = new Date();
    const sorted = [...canvasImages].sort((a, b) => {
      const aTime = new Date(a.created_at || 0).getTime();
      const bTime = new Date(b.created_at || 0).getTime();
      // Group by 5-minute batches
      const aBatch = Math.floor(aTime / 300000);
      const bBatch = Math.floor(bTime / 300000);
      if (aBatch !== bBatch) return aBatch - bBatch;
      // Within same batch, reference images first, then generated
      const aIsRef = a.is_reference ? 0 : 1;
      const bIsRef = b.is_reference ? 0 : 1;
      if (aIsRef !== bIsRef) return aIsRef - bIsRef;
      return aTime - bTime;
    });

    // Calculate group boundaries
    const groups: { key: string; images: typeof sorted }[] = [];
    let currentGroupKey = '';
    for (const img of sorted) {
      const aTime = new Date(img.created_at || 0).getTime();
      const batch = Math.floor(aTime / 300000);
      const typeKey = img.is_reference ? 'ref' : 'gen';
      const groupKey = `${batch}-${typeKey}`;
      if (groupKey !== currentGroupKey) {
        groups.push({ key: groupKey, images: [] });
        currentGroupKey = groupKey;
      }
      groups[groups.length - 1].images.push(img);
    }

    const avgWidth = sorted.reduce((s, img) => s + getCanvasImageDisplaySize(img).w, 0) / sorted.length;
    const maxRowWidth = viewWidth - PADDING * 2;

    // Place groups sequentially
    const positions: Record<string, { x: number; y: number }> = {};
    let curY = PADDING;

    for (const group of groups) {
      let curX = PADDING;
      let rowHeight = 0;

      for (const img of group.images) {
        const display = getCanvasImageDisplaySize(img);
        const w = display.w;
        const h = display.h;

        if (curX + w > maxRowWidth + PADDING && curX > PADDING) {
          curX = PADDING;
          curY += rowHeight + GAP;
          rowHeight = 0;
        }

        positions[img.id] = { x: curX, y: curY };
        rowHeight = Math.max(rowHeight, h);
        curX += w + GAP;
      }

      curY += rowHeight + GROUP_GAP;
    }

    // Apply positions
    const updated = canvasImages.map((img) => {
      const pos = positions[img.id];
      if (!pos) return img;
      return { ...img, canvas_x: pos.x, canvas_y: pos.y };
    });

    setCanvasImages(updated);

    // Save all positions to DB
    for (const img of updated) {
      fetch("/api/history", {
        method: "PATCH",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify({
          id: img.id,
          canvas_x: Math.round(img.canvas_x),
          canvas_y: Math.round(img.canvas_y),
          canvas_width: Math.round(getCanvasImageDisplaySize(img).w),
          canvas_height: Math.round(getCanvasImageDisplaySize(img).h),
        }),
      }).catch(() => {});
    }
  }, [canvasImages, canvasScale, getCanvasImageDisplaySize]);

  // ─── Zoom to scale centered on selected image ───
  const zoomToScale = useCallback(
    (newScale: number) => {
      const container = document.getElementById("canvas-container");
      if (!container) {
        setCanvasScale(newScale);
        return;
      }
      const rect = container.getBoundingClientRect();
      const selImg = canvasImages.find((i) => i.id === selectedImageId);
      let focusX: number, focusY: number;
      if (selImg) {
        const display = getCanvasImageDisplaySize(selImg);
        focusX = (selImg.canvas_x + display.w / 2) * canvasScale + canvasOffset.x;
        focusY = (selImg.canvas_y + display.h / 2) * canvasScale + canvasOffset.y;
      } else {
        focusX = rect.width / 2;
        focusY = rect.height / 2;
      }
      const scaleRatio = newScale / canvasScale;
      setCanvasOffset({
        x: focusX - (focusX - canvasOffset.x) * scaleRatio,
        y: focusY - (focusY - canvasOffset.y) * scaleRatio,
      });
      setCanvasScale(newScale);
    },
    [canvasScale, canvasOffset, canvasImages, selectedImageId, getCanvasImageDisplaySize]
  );

  // ─── Snap constants ───
  const GRID_SIZE = 20;
  const SNAP_THRESHOLD = 8;

  // ─── Snap position to nearby edges & grid ───
  const snapPosition = useCallback(
    (x: number, y: number, w: number, h: number, excludeId?: string) => {
      let snappedX = x;
      let snappedY = y;
      const linesX: number[] = [];
      const linesY: number[] = [];

      // Snap to grid
      const gridX = Math.round(x / GRID_SIZE) * GRID_SIZE;
      const gridY = Math.round(y / GRID_SIZE) * GRID_SIZE;
      if (Math.abs(x - gridX) < SNAP_THRESHOLD) { snappedX = gridX; linesX.push(gridX); }
      if (Math.abs(y - gridY) < SNAP_THRESHOLD) { snappedY = gridY; linesY.push(gridY); }

      // Snap to other images' edges
      for (const img of canvasImages) {
        if (img.id === excludeId) continue;
        const display = getCanvasImageDisplaySize(img);
        const edges = [
          { val: img.canvas_x, type: "left" as const },
          { val: img.canvas_x + display.w, type: "right" as const },
          { val: img.canvas_y, type: "top" as const },
          { val: img.canvas_y + display.h, type: "bottom" as const },
        ];

        // Current image edges
        const myLeft = snappedX;
        const myRight = snappedX + w;
        const myTop = snappedY;
        const myBottom = snappedY + h;

        for (const edge of edges) {
          if (edge.type === "left" || edge.type === "right") {
            // my left snaps to their left/right
            if (Math.abs(myLeft - edge.val) < SNAP_THRESHOLD) {
              snappedX = edge.val;
              linesX.push(edge.val);
            }
            // my right snaps to their left/right
            if (Math.abs(myRight - edge.val) < SNAP_THRESHOLD) {
              snappedX = edge.val - w;
              linesX.push(edge.val);
            }
          } else {
            // my top snaps to their top/bottom
            if (Math.abs(myTop - edge.val) < SNAP_THRESHOLD) {
              snappedY = edge.val;
              linesY.push(edge.val);
            }
            // my bottom snaps to their top/bottom
            if (Math.abs(myBottom - edge.val) < SNAP_THRESHOLD) {
              snappedY = edge.val - h;
              linesY.push(edge.val);
            }
          }
        }

        // Also snap with gap: image next to each other
        const GAP = 16;
        // my left = their right + gap
        if (Math.abs(myLeft - (img.canvas_x + display.w + GAP)) < SNAP_THRESHOLD) {
          snappedX = img.canvas_x + display.w + GAP;
          linesX.push(img.canvas_x + display.w + GAP);
        }
        // my right = their left - gap
        if (Math.abs(myRight - (img.canvas_x - GAP)) < SNAP_THRESHOLD) {
          snappedX = img.canvas_x - GAP - w;
          linesX.push(img.canvas_x - GAP);
        }
        // my top = their bottom + gap
        if (Math.abs(myTop - (img.canvas_y + display.h + GAP)) < SNAP_THRESHOLD) {
          snappedY = img.canvas_y + display.h + GAP;
          linesY.push(img.canvas_y + display.h + GAP);
        }
        // my bottom = their top - gap
        if (Math.abs(myBottom - (img.canvas_y - GAP)) < SNAP_THRESHOLD) {
          snappedY = img.canvas_y - GAP - h;
          linesY.push(img.canvas_y - GAP);
        }
      }

      return { x: Math.round(snappedX), y: Math.round(snappedY), linesX, linesY };
    },
    [canvasImages, getCanvasImageDisplaySize]
  );

