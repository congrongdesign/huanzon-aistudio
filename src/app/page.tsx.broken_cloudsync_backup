// ─── Generating Placeholder with Progress ───
function GeneratingPlaceholder({ startTime, prompt, onCancel }: { startTime?: number; prompt?: string; onCancel?: () => void }) {
  const [elapsed, setElapsed] = useState(0);
  const estimatedTotal = 45; // average generation time in seconds

  useEffect(() => {
    if (!startTime) return;
    const interval = setInterval(() => {
      setElapsed(Math.floor((Date.now() - startTime) / 1000));
    }, 1000);
    return () => clearInterval(interval);
  }, [startTime]);

  const progress = Math.min(95, Math.floor((elapsed / estimatedTotal) * 100));
  const remaining = Math.max(0, estimatedTotal - elapsed);

  const formatTime = (s: number) => {
    if (s < 60) return `${s}秒`;
    return `${Math.floor(s / 60)}分${s % 60}秒`;
  };

  return (
    <div className="w-full h-full flex flex-col items-center justify-center bg-muted/60 rounded-lg border border-dashed border-border/50">
      {/* Spinner */}
      <div className="relative w-12 h-12 mb-3">
        <svg className="w-12 h-12 animate-spin" viewBox="0 0 48 48">
          <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" strokeWidth="3" className="text-border/30" />
          <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round"
            strokeDasharray={`${progress * 1.26} ${125.6 - progress * 1.26}`}
            className="text-foreground/80" style={{ transform: 'rotate(-90deg)', transformOrigin: 'center' }} />
        </svg>
        <span className="absolute inset-0 flex items-center justify-center text-xs font-semibold text-foreground">
          {progress}%
        </span>
      </div>
      <span className="mb-1 whitespace-nowrap text-xs text-muted-foreground">AI 生成中...</span>
      {elapsed > 3 && (
        <span className="whitespace-nowrap text-[10px] text-muted-foreground">
          预计剩余 {formatTime(remaining)}
        </span>
      )}
      {onCancel && (
        <button
          onClick={(e) => { e.stopPropagation(); onCancel(); }}
          className="mt-2 flex cursor-pointer items-center gap-1 whitespace-nowrap rounded-md border border-border/30 bg-muted/80 px-3 py-1 text-[10px] text-muted-foreground transition-colors hover:bg-red-500/10 hover:text-red-400"
        >
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round">
            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
          </svg>
          取消生成
        </button>
      )}
    </div>
  );
}

