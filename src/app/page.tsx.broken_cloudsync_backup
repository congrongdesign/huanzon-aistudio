      setCanvasImages(prev => prev.map(img => {
        if (img.id !== resizingImageId) return img;
        let newW = resizeStart.w, newH = resizeStart.h, newX = resizeStart.x, newY = resizeStart.y;
        if (resizeCorner === "se") {
          newW = Math.max(60, resizeStart.w + dx);
          newH = newW / aspectRatio;
        } else if (resizeCorner === "sw") {
          newW = Math.max(60, resizeStart.w - dx);
          newH = newW / aspectRatio;
          newX = resizeStart.x + resizeStart.w - newW;
        } else if (resizeCorner === "ne") {
          newW = Math.max(60, resizeStart.w + dx);
          newH = newW / aspectRatio;
          newY = resizeStart.y + resizeStart.h - newH;
        } else if (resizeCorner === "nw") {
          newW = Math.max(60, resizeStart.w - dx);
          newH = newW / aspectRatio;
          newX = resizeStart.x + resizeStart.w - newW;
          newY = resizeStart.y + resizeStart.h - newH;
        }
        return { ...img, canvas_x: Math.round(newX), canvas_y: Math.round(newY), canvas_width: Math.round(newW), canvas_height: Math.round(newH) };
