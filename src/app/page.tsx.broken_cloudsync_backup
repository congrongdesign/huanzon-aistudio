            重新生成
          </button>
        )}
        {onRemove && (
          <button onClick={(e) => { e.stopPropagation(); onRemove(); }} className="text-[10px] px-2.5 py-0.5 rounded-md bg-muted text-muted-foreground hover:bg-muted/80 transition-colors cursor-pointer">
            移除
          </button>
        )}
      </div>
      {showDetail && prompt && (
        <div className="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-popover text-popover-foreground text-[10px] rounded shadow-lg max-w-[200px] whitespace-normal z-50 pointer-events-none">
          {failed.detail || failed.task}
        </div>
      )}
    </div>
  );
}

