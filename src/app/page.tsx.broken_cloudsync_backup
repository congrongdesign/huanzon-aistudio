    setCanvasDragOver(false);

    // Check for image URL drag from chat panel
    const imageUrl = e.dataTransfer.getData("application/image-url") || e.dataTransfer.getData("text/plain");
    if (imageUrl && imageUrl.startsWith("http") && !e.dataTransfer.files.length) {
      // Get drop position on canvas
      const canvasContainer = document.getElementById("canvas-container");
      if (canvasContainer) {
        const rect = canvasContainer.getBoundingClientRect();
        const dropX = (e.clientX - rect.left) / canvasScaleRef.current - canvasOffsetRef.current.x / canvasScaleRef.current;
        const dropY = (e.clientY - rect.top) / canvasScaleRef.current - canvasOffsetRef.current.y / canvasScaleRef.current;

        // Try to load image to get aspect ratio
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = async () => {
          const aspect = img.naturalWidth / img.naturalHeight;
          const w = 320;
          const h = Math.round(w / aspect);

          // Find non-overlapping position
          const pos = findNonOverlappingPosition(Math.round(dropX - w / 2), Math.round(dropY - h / 2), w, h);

          const newImage: CanvasImage = {
            id: `chat-drag-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
            project_id: currentProjectId,
            prompt: "从对话拖入",
            image_url: imageUrl,
            image_key: "",
            reference_images: null,
            canvas_x: pos.x,
            canvas_y: pos.y,
            canvas_width: w,
            canvas_height: h,
            size: `${aspect.toFixed(2)}:1`,
            model: "chat-drag",
            status: "completed",
            is_favorite: false,
            created_at: new Date().toISOString(),
            updated_at: null,
          };
          setCanvasImages((prev) => [...prev, newImage]);
          canvasImagesRef.current = [...canvasImagesRef.current, newImage];
          panCanvasToPosition(pos.x, pos.y, w, h);

          // Persist to image_records
          if (currentProjectId) {
            try {
              await fetch("/api/history", {
                method: "POST",
                headers: { "Content-Type": "application/json", ...getAuthHeaders() },
                body: JSON.stringify({
                  id: newImage.id,
                  projectId: currentProjectId,
                  prompt: newImage.prompt,
                  imageUrl: newImage.image_url,
                  imageKey: newImage.image_key,
                  size: newImage.size,
                  model: newImage.model,
                  status: "completed",
                  canvasX: newImage.canvas_x,
                  canvasY: newImage.canvas_y,
                  canvasWidth: newImage.canvas_width,
                  canvasHeight: newImage.canvas_height,
                }),
              });
            } catch {}
          }
        };
        img.src = imageUrl;
      }
      return;
    }

    // Handle file drops (existing logic)
    const files = Array.from(e.dataTransfer.files).filter((f) =>
      f.type.startsWith("image/")
    );

    // Calculate drop position on canvas
    const canvasContainer = document.getElementById("canvas-container");
    let dropCanvasX = 100, dropCanvasY = 100;
    if (canvasContainer) {
      const rect = canvasContainer.getBoundingClientRect();
      dropCanvasX = (e.clientX - rect.left) / canvasScaleRef.current - canvasOffsetRef.current.x / canvasScaleRef.current;
      dropCanvasY = (e.clientY - rect.top) / canvasScaleRef.current - canvasOffsetRef.current.y / canvasScaleRef.current;
    }

    for (const file of files) {
      // Step 1: Get image dimensions immediately via createObjectURL
      const objectUrl = URL.createObjectURL(file);
      const dimPromise = new Promise<{ w: number; h: number }>((resolve) => {
        const img = new Image();
        img.onload = () => resolve({ w: img.naturalWidth, h: img.naturalHeight });
        img.onerror = () => resolve({ w: 320, h: 320 }); // fallback
        img.src = objectUrl;
      });
      const { w: natW, h: natH } = await dimPromise;
      const aspect = natW / natH;
      const displayW = 320;
      const displayH = Math.round(displayW / aspect);

      // Step 2: Calculate position with non-overlap
      const startX = Math.round(dropCanvasX - displayW / 2);
      const startY = Math.round(dropCanvasY - displayH / 2);
      const pos = findNonOverlappingPosition(startX, startY, displayW, displayH);

      // Step 3: Add placeholder with correct dimensions
      const placeholderId = `upload-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`;
      const placeholder: CanvasImage = {
        id: placeholderId,
        project_id: currentProjectId,
        prompt: `上传中: ${file.name}`,
        image_url: "",
        image_key: "",
        reference_images: null,
        canvas_x: pos.x,
        canvas_y: pos.y,
        canvas_width: displayW,
        canvas_height: displayH,
        size: `${aspect.toFixed(2)}:1`,
        model: "upload",
        status: "pending",
        is_favorite: false,
        isUploading: true,
        is_reference: true,
        created_at: new Date().toISOString(),
        updated_at: null,
      };
      // Only show placeholder if upload takes > 300ms
      const placeholderTimer = setTimeout(() => {
        setCanvasImages((prev) => [...prev, placeholder]);
        canvasImagesRef.current = [...canvasImagesRef.current, placeholder];
        setRefUploading(true);
        panCanvasToPosition(pos.x, pos.y, displayW, displayH);
      }, 300);

      // Step 4: Upload to S3
      const formData = new FormData();
      formData.append("file", file);
      if (currentProjectId) formData.append("projectId", currentProjectId);
      try {
        const res = await fetch("/api/upload", { method: "POST", headers: getAuthHeaders(), body: formData });
        const data = await res.json();
        clearTimeout(placeholderTimer);
        if (data.url) {
          // Step 5: Replace placeholder with real image (same position, same size)
          const newImage: CanvasImage = {
            id: placeholderId,
            project_id: currentProjectId,
            prompt: `上传: ${file.name}`,
            image_url: data.url,
            image_key: data.key,
            reference_images: null,
            canvas_x: pos.x,
            canvas_y: pos.y,
            canvas_width: displayW,
            canvas_height: displayH,
            size: `${aspect.toFixed(2)}:1`,
            model: "upload",
            status: "completed",
            is_favorite: false,
            is_reference: true,
            created_at: new Date().toISOString(),
            updated_at: null,
          };
          setCanvasImages((prev) => {
            const exists = prev.some((ci) => ci.id === placeholderId);
            if (exists) {
              const updated = prev.map((ci) => ci.id === placeholderId ? newImage : ci);
              canvasImagesRef.current = updated;
              return updated;
            } else {
              canvasImagesRef.current = [...canvasImagesRef.current, newImage];
              return [...prev, newImage];
            }
          });
          panCanvasToPosition(pos.x, pos.y, displayW, displayH);
          // Save to reference_images table for persistence
          if (currentProjectId) {
            fetch("/api/references", {
              method: "POST",
              headers: { "Content-Type": "application/json", ...getAuthHeaders() },
              body: JSON.stringify({
                projectId: currentProjectId,
                imageUrl: data.url,
                imageKey: data.key,
                fileName: file.name,
              }),
            }).catch(() => {});
          }
          setRefUploading(false);
        } else {
          setCanvasImages((prev) => prev.filter((ci) => ci.id !== placeholderId));
          canvasImagesRef.current = canvasImagesRef.current.filter((ci) => ci.id !== placeholderId);
          setRefUploading(false);
        }
      } catch {
        setCanvasImages((prev) => prev.filter((ci) => ci.id !== placeholderId));
        canvasImagesRef.current = canvasImagesRef.current.filter((ci) => ci.id !== placeholderId);
        setRefUploading(false);
      } finally {
        URL.revokeObjectURL(objectUrl);
      }
    }
  };

  const handleDragOver = (e: React.DragEvent) => {
    e.preventDefault();
    e.stopPropagation();
    if (e.dataTransfer.types.includes("Files") || e.dataTransfer.types.includes("text/plain")) {
      e.dataTransfer.dropEffect = "copy";
      setCanvasDragOver(true);
    }
  };

  const handleDragLeave = (e: React.DragEvent) => {
    e.preventDefault();
    e.stopPropagation();
    // Only clear if actually leaving the canvas container (not entering a child)
    const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
    if (e.clientX <= rect.left || e.clientX >= rect.right || e.clientY <= rect.top || e.clientY >= rect.bottom) {
      setCanvasDragOver(false);
    }
  };

  // ─── Add image as reference ───
  const addAsReference = (url: string) => {
    setChatPanelOpen(true);
    setTimeout(() => {
      insertReferenceChipsAtCursor([{ url }]);
    }, 50);
  };

  // ─── Add multiple images as references ───
  const addMultipleAsReferences = (urls: string[]) => {
    setChatPanelOpen(true);
    setTimeout(() => {
      const el = richInputRef.current;
      const existingUrls = new Set(
        Array.from(el?.querySelectorAll<HTMLElement>('[data-type="ref-chip"]') || [])
          .map((chip) => chip.dataset.url)
          .filter(Boolean) as string[],
      );
      const normalized = normalizeReferenceUrls(urls.filter((url) => !existingUrls.has(url)));
      const newUrls = normalized.urls;
      if (newUrls.length > 0) {
        insertReferenceChipsAtCursor(newUrls.map((url) => ({ url })));
      }
      if (normalized.ignored > 0) {
        setActionToast(`模型最多同时参考 ${MAX_MODEL_REFERENCE_IMAGES} 张图，已自动忽略多余图片`);
        setTimeout(() => setActionToast(null), 2200);
      }
    }, 50);
  };

  const removeReference = (url: string) => {
    setReferenceImages((prev) => prev.filter((u) => u !== url));
  };

  const getActiveSelectedReferenceUrls = useCallback(() => {
    const primaryId = selectedImageIdRef.current;
    const selectedIds = selectedImageIdsRef.current;
    const orderedIds = primaryId
      ? [primaryId, ...selectedIds.filter((id) => id !== primaryId)]
      : [...selectedIds];
    const candidateIds = orderedIds.length > 0 ? orderedIds : (primaryId ? [primaryId] : []);
    const urls = candidateIds
      .map((id) => canvasImagesRef.current.find((img) => img.id === id))
      .filter((img): img is CanvasImage => Boolean(img && !img.isGenerating && img.image_url))
      .map((img) => img.image_url);
    return normalizeReferenceUrls(urls).urls;
  }, []);

  const pendingSelectedReferenceUrls = useMemo(() => {
    const activeIds = selectedImageId
      ? [selectedImageId, ...selectedImageIds.filter((id) => id !== selectedImageId)]
      : [...selectedImageIds];
    const candidateIds = activeIds.length > 0 ? activeIds : (selectedImageId ? [selectedImageId] : []);
    return canvasImages
      .filter((img) => candidateIds.includes(img.id) && !img.isGenerating && img.image_url)
      .map((img) => img.image_url);
  }, [canvasImages, selectedImageId, selectedImageIds]);

  const pendingUninsertedReferenceUrls = useMemo(
    () => pendingSelectedReferenceUrls.filter((url) => !richReferenceUrls.includes(url)),
    [pendingSelectedReferenceUrls, richReferenceUrls],
  );

  const insertSelectedImagesIntoRichInput = useCallback(() => {
    const latestSelectedUrls = getActiveSelectedReferenceUrls();
    if (latestSelectedUrls.length === 0) return;
    const domUrls = Array.from(richInputRef.current?.querySelectorAll<HTMLElement>('[data-type="ref-chip"]') || [])
      .map((chip) => chip.dataset.url)
      .filter(Boolean) as string[];
    const existingUrls = new Set([...richReferenceUrlsRef.current, ...domUrls]);
    const nextUrls = latestSelectedUrls.filter((url) => !existingUrls.has(url));
    if (nextUrls.length === 0) return;
    insertReferenceChipsAtCursor(nextUrls.map((url) => ({ url })));
  }, [getActiveSelectedReferenceUrls, insertReferenceChipsAtCursor]);

  useEffect(() => {
    if (!chatInputFocused) return;
    const timer = window.setTimeout(() => {
      insertSelectedImagesIntoRichInput();
    }, 0);
    return () => window.clearTimeout(timer);
  }, [chatInputFocused, selectedImageId, selectedImageIds, insertSelectedImagesIntoRichInput]);

  const applyTextToRichInput = useCallback((text: string, mode: "replace" | "append" = "replace") => {
    const clean = text.trim();
    if (!clean) return;
    const el = richInputRef.current;
    if (!el) {
      setChatInput((prev) => mode === "append" && prev.trim() ? `${prev.trimEnd()}\n${clean}` : clean);
      setChatPanelOpen(true);
      return;
    }

    const insertPlainText = (range: Range, value: string) => {
      const lines = value.split("\n");
      lines.forEach((line, index) => {
        if (index > 0) {
          const br = document.createElement("br");
          range.insertNode(br);
          range.setStartAfter(br);
          range.collapse(true);
        }
        if (line) {
          const textNode = document.createTextNode(line);
          range.insertNode(textNode);
          range.setStartAfter(textNode);
          range.collapse(true);
        }
      });
    };

    const selection = window.getSelection();
    let range: Range | null = null;
    if (selection && selection.rangeCount > 0) {
      const candidate = selection.getRangeAt(0);
      if (el.contains(candidate.commonAncestorContainer)) {
        range = candidate;
      }
    }

    el.focus();
    if (mode === "replace") {
      el.innerHTML = "";
      range = document.createRange();
      range.selectNodeContents(el);
      range.collapse(false);
      insertPlainText(range, clean);
    } else {
      if (!range) {
        range = document.createRange();
        range.selectNodeContents(el);
        range.collapse(false);
      }
      const hasContent = Boolean(getRichInputParts(el).text.replace(/\u00a0/g, " ").trim() || el.querySelector('[data-type="ref-chip"]'));
      range.deleteContents();
      insertPlainText(range, hasContent ? `\n${clean}` : clean);
    }

    selection?.removeAllRanges();
    selection?.addRange(range);
    syncChatInputFromRich();
    setChatPanelOpen(true);
    setTimeout(() => richInputRef.current?.focus(), 50);
  }, []);

  const handleUseGenerationCase = useCallback((item: GenerationCase, mode: "fill" | "generate") => {
    const pack = assetStylePacks.find((style) => style.id === item.stylePackId) || getGenerationStylePack(item.stylePackId);
    if (pack) setSelectedStylePackId(pack.id);
    setImageSize(item.aspectRatio);
    setImageCount(item.count);
    applyTextToRichInput(item.prompt);
    setActionToast(`已套用案例：${item.title}`);
    setTimeout(() => setActionToast(null), 2000);
    if (mode === "generate") {
      for (let i = 0; i < item.count; i++) generateImage(item.prompt, { size: item.aspectRatio, stylePackId: item.stylePackId });
    }
  }, [applyTextToRichInput, assetStylePacks, generateImage]);

  const handleSelectStylePack = useCallback((packId: string) => {
    setSelectedStylePackId(packId);
    const pack = assetStylePacks.find((style) => style.id === packId) || getGenerationStylePack(packId);
    setActionToast(pack ? `已启用风格包：${pack.name}` : "已启用风格包");
    setTimeout(() => setActionToast(null), 2000);
  }, [assetStylePacks]);

  const handleApplyStyleToPrompt = useCallback((pack: GenerationStylePack) => {
    setSelectedStylePackId(pack.id);
    applyTextToRichInput(`风格要求：${pack.description}\n${pack.promptSuffix}`, "append");
    setActionToast(`已追加风格描述：${pack.name}`);
    setTimeout(() => setActionToast(null), 2000);
  }, [applyTextToRichInput]);

  // ─── Get current aspect ratios based on model ───
  const getCurrentRatios = () => {
    if (imageModel === "gpt-image-2-vip") return ASPECT_RATIOS; // VIP uses pixel sizes, not shown here
    const isNanoBanana2 = imageModel.startsWith("nano-banana-2");
    if (isNanoBanana2) return ASPECT_RATIOS_EXTENDED;
    return ASPECT_RATIOS;
  };

  const selectedImage = canvasImages.find((i) => i.id === selectedImageId);
  const currentProject = projects.find((p) => p.id === currentProjectId);

  // Gallery card renderer - Eagle-style pure thumbnail
  function renderGalleryCard(img: CanvasImage, idx: number) {
    const isSelected = gallerySelected.includes(img.id);
    const isDetailSelected = galleryDetailId === img.id;
    const ratio = getImageRatio([`gallery:${img.id}`, `canvas:${img.id}`, `url:${img.image_url}`], img.canvas_width, img.canvas_height, (() => {
      if (img.canvas_width > 0 && img.canvas_height > 0) return img.canvas_width / img.canvas_height;
      const s = img.size || "1:1";
      const parts = s.split("x");
      if (parts.length === 2 && parseInt(parts[0]) > 0 && parseInt(parts[1]) > 0) return parseInt(parts[0]) / parseInt(parts[1]);
      const ratioParts = s.split(":");
      if (ratioParts.length === 2 && parseInt(ratioParts[0]) > 0) return parseInt(ratioParts[0]) / parseInt(ratioParts[1]);
      return 1;
    })());
    const w = Math.round(ratio * galleryThumbSize);
    const h = galleryThumbSize;
    const isListView = galleryViewMode === "list";
    const tags = imageTagMap[img.id] || [];
    const colorCat = imageColorCache[img.id];

    if (isListView) {
      return (
        <div
          key={`gallery-${img.id}`}
          data-img-idx={idx}
          onClick={(e) => handleGalleryImageClick(e, img, idx)}
          className={`flex items-center gap-3 px-3 py-2 cursor-pointer transition-colors border-l-2 ${
            isDetailSelected ? "bg-primary/15 border-l-border-secondary" : isSelected ? "bg-primary/10 border-l-border-secondary" : "border-l-transparent hover:bg-muted"
          }`}
        >
          {/* Thumbnail */}
          <div className="w-12 h-12 rounded overflow-hidden bg-muted shrink-0 flex items-center justify-center">
            {img.status === 'failed' || !img.image_url ? (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" className="text-muted-foreground/40">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
              </svg>
            ) : (
              <img src={img.image_url} alt="" className="max-w-full max-h-full object-contain" loading="lazy"
                onError={(e) => { e.currentTarget.style.display = 'none'; }} />
            )}
          </div>
          {/* Info */}
          <div className="flex-1 min-w-0">
            <p className="text-xs text-foreground truncate">{img.prompt?.slice(0, 50) || "无提示词"}</p>
            <div className="flex items-center gap-2 mt-0.5">
              <span className="text-[10px] text-muted-foreground">{img.size}</span>
              <span className="text-[10px] text-muted-foreground">{img.model}</span>
              {colorCat && <span className="inline-block w-2 h-2 rounded-full" style={{ background: TONE_CATEGORIES[colorCat]?.color || "#888" }} />}
            </div>
          </div>
          {/* Tags */}
          <div className="flex gap-1 shrink-0 max-w-[200px] overflow-hidden items-center">
            {tags.slice(0, 3).map((t) => (
              <span key={t} className="text-[10px] px-1.5 py-0.5 bg-primary/20 text-primary rounded-full whitespace-nowrap">{t}</span>
            ))}
            {tags.length > 3 && <span className="text-[10px] text-muted-foreground">+{tags.length - 3}</span>}
            <button
              onClick={(e) => { e.stopPropagation(); setGalleryDetailId(img.id); }}
              className="text-[9px] px-1 py-0.5 text-muted-foreground hover:text-primary hover:bg-primary/15 rounded-full opacity-0 group-hover:opacity-100 transition-all"
              title="管理标签"
            >+标签</button>
          </div>
          {/* Date */}
          <span className="text-[10px] text-muted-foreground shrink-0">{new Date(img.created_at).toLocaleDateString()}</span>
          {/* Delete button */}
          <button
            onClick={(e) => { e.stopPropagation(); deleteImage(img.id); }}
            className="p-1 rounded hover:bg-red-900/60 text-muted-foreground hover:text-red-400 opacity-0 group-hover:opacity-100 transition-all shrink-0"
            title="删除"
          >
            <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        </div>
      );
    }

    // Grid / Masonry / Adaptive view
    return (
      <div
        key={`gallery-${img.id}`}
        data-img-idx={idx}
        data-gallery-selected={isDetailSelected || isSelected ? "true" : "false"}
        onClick={(e) => handleGalleryImageClick(e, img, idx)}
        className={`gallery-card group relative cursor-pointer transition-all ${
          galleryViewMode === "masonry" || galleryViewMode === "adaptive"
            ? "break-inside-avoid mb-2"
            : "self-start h-fit"
        } ${
          isDetailSelected
            ? "ring-2 ring-border-secondary ring-offset-1 ring-offset-background rounded-lg"
            : isSelected
            ? "ring-2 ring-border-secondary rounded-lg"
            : "rounded-lg hover:ring-1 hover:ring-muted-foreground"
        }`}
        style={galleryViewMode === "grid" ? { width: "100%" } : undefined}
      >
        {/* Selection checkbox - always visible */}
        <button
          onClick={(e) => {
            e.stopPropagation();
            setGallerySelected((prev) => prev.includes(img.id) ? prev.filter((i) => i !== img.id) : [...prev, img.id]);
          }}
          className={`absolute top-1 left-1 z-10 w-5 h-5 rounded-md flex items-center justify-center transition-all border ${
            isSelected
              ? "bg-primary border-primary"
              : "bg-card/70 border-border-muted/50 opacity-0 group-hover:opacity-100"
          }`}
        >
          {isSelected && <svg className="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={3} d="M5 13l4 4L19 7" /></svg>}
        </button>
        {/* Favorite star */}
        {img.is_favorite && (
          <div className="absolute top-1 right-1 z-10">
            <svg className="w-4 h-4 text-amber-400 drop-shadow" fill="currentColor" viewBox="0 0 24 24"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
          </div>
        )}
        {/* Hover delete button */}
        <button
          onClick={(e) => { e.stopPropagation(); deleteImage(img.id); }}
          className="absolute top-1 right-1 z-10 w-6 h-6 rounded-md flex items-center justify-center bg-black/60 hover:bg-red-600/80 opacity-0 group-hover:opacity-100 transition-all"
          title="删除"
        >
          <svg className="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
        </button>
        {/* Color dot indicator */}
        {colorCat && (
        <div className="gallery-tone-dot absolute bottom-7 right-1 z-10">
            <span className="inline-block w-3 h-3 rounded-full border border-border/50 shadow-sm" style={{ background: TONE_CATEGORIES[colorCat]?.color || "#888" }} />
          </div>
        )}
        {/* Image */}
        <div className="overflow-hidden bg-muted/50 rounded-lg" style={{ aspectRatio: `${ratio} / 1` }}>
          {img.status === 'failed' || !img.image_url ? (
            <div className="w-full h-full flex flex-col items-center justify-center bg-muted/80">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" className="text-muted-foreground/50 mb-1">
