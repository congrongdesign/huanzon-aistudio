    const processLabels: Record<string, string> = { 'remove-bg': '去背景', 'upscale': '高清化', 'extract': '抠图' };
    if (!steps || steps.length === 0) return '（暂无步骤配置）';
    return steps.map((s, i) => {
      const label = typeLabels[s.type] || s.type;
      const cfg = s.config;
      let detail = '';
      if (s.type === 'generate') {
        detail = `提示词: "${cfg.promptTemplate || '(未设置)'}", 模型: ${cfg.model || 'gpt-image-2'}, 比例: ${cfg.aspectRatio || '1:1'}`;
      } else if (s.type === 'analyze') {
        detail = `输出变量: ${cfg.outputVar || '(未设置)'}`;
      } else if (s.type === 'chat') {
        detail = `模板: "${cfg.promptTemplate || '(未设置)'}", 输出变量: ${cfg.outputVar || '(未设置)'}`;
      } else if (s.type === 'process') {
        detail = `操作: ${processLabels[cfg.action as string] || cfg.action || '(未设置)'}`;
