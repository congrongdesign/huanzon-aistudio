                          if (node.nodeType === Node.TEXT_NODE) {
                            const text = node.textContent || '';
                            const textBeforeCursor = text.slice(0, range.startOffset);
                            const atMatch = textBeforeCursor.match(/@([^@\s]*)$/);
                            if (atMatch) {
                              setAtMentionOpen(true);
                              setAtMentionQuery(atMatch[1]);
                              setAtMentionIndex(0);
                              atMentionStartRef.current = range.startOffset - atMatch[0].length;
                            } else {
                              setAtMentionOpen(false);
                            }
                          }
                        }
                        syncChatInputFromRich();
                        setChatInputFocused(true);
                      }}
                      onKeyDown={(e) => {
                        // Handle @mention navigation
                        if (atMentionOpen) {
                          const allImages = canvasImages.filter(i => !i.isGenerating);
                          const query = atMentionQuery.toLowerCase();
                          const filtered = allImages.filter(img => {
                            const name = img.prompt?.slice(0, 30) || img.id.slice(0, 8);
                            return !query || name.toLowerCase().includes(query);
                          });
                          if (e.key === "ArrowDown") {
                            e.preventDefault();
                            setAtMentionIndex(prev => {
                              const next = Math.min(prev + 1, filtered.length - 1);
                              setTimeout(() => atMentionRef.current?.querySelector(`[data-mention-idx="${next}"]`)?.scrollIntoView({ block: 'nearest' }), 0);
                              return next;
                            });
                            return;
                          }
                          if (e.key === "ArrowUp") {
                            e.preventDefault();
                            setAtMentionIndex(prev => {
                              const next = Math.max(prev - 1, 0);
                              setTimeout(() => atMentionRef.current?.querySelector(`[data-mention-idx="${next}"]`)?.scrollIntoView({ block: 'nearest' }), 0);
                              return next;
                            });
                            return;
                          }
                          if (e.key === "Enter" || e.key === "Tab") {
                            e.preventDefault();
                            if (filtered[atMentionIndex]) {
                              const fi = filtered[atMentionIndex];
                              handleInsertInlineRef({ id: fi.id, url: fi.image_url, label: `图${inlineRefCounter + 1}`, prompt: fi.prompt });
                            }
                            setAtMentionOpen(false);
                            return;
                          }
                          if (e.key === "Escape") {
                            e.preventDefault();
                            setAtMentionOpen(false);
                            return;
                          }
                        }
                        if ((e.key === "Backspace" || e.key === "Delete") && !atMentionOpen) {
                          window.setTimeout(() => {
                            syncChatInputFromRich();
                          }, 0);
                        }
                        if (e.key === "Enter" && !e.shiftKey && !atMentionOpen) {
