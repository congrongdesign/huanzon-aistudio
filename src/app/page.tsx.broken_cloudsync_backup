  // ─── Image tool handler ───
  const handleImageTool = useCallback(async (img: CanvasImage, tool: string) => {
    if (processingAction) return;

    if (tool !== "reversePrompt" && (!apiKey || !baseUrl)) {
      alert("请先配置 API Key 和 Base URL");
      return;
    }

    const toolConfig: Record<string, { prompt: string; label: string }> = {
      expand: { prompt: "将这张图片向外扩展，保持原有风格和构图，填充周围场景，使画面更加完整", label: "扩图" },
      removeBg: { prompt: "Remove the background from this image completely, keep only the main subject, output on transparent background", label: "去背" },
      reversePrompt: { prompt: "", label: "反推提示词" },
      hdUpscale: { prompt: "Upscale and enhance this image to higher resolution and better quality, improve details and sharpness while keeping the original composition and style unchanged", label: "高清" },
      cutout: { prompt: "Extract the main subject from this image, remove everything else, place the subject on a clean white background", label: "抠图" },
    };

    // ─── Expand: enter expand mode ───
    if (tool === "expand") {
      setExpandMode({ imageId: img.id, expandLeft: 0, expandRight: 0, expandTop: 0, expandBottom: 0, imageOffsetX: 0, imageOffsetY: 0 });
      return;
    }

    // ─── Inpaint: enter inpaint mode ───
    if (tool === "inpaint") {
      setInpaintMode({ imageId: img.id, strokes: [] as { x: number; y: number }[][], brushSize: 10, prompt: '' });
      setInpaintSmartMaskBase64(null);
      setInpaintRectSelecting(false);
      setInpaintRectStart(null);
      setInpaintRectEnd(null);
      setInpaintElementMap(null);
      setInpaintHoverElementId(null);
      setInpaintSelectedElementIds([]);
      return;
    }

    const config = toolConfig[tool];
    if (!config) return;

    setProcessingAction(config.label);

    // ─── Reverse prompt: use chat API analyze ───
    if (tool === "reversePrompt") {
      try {
        const reverseBaseUrl = (chatBaseUrl || baseUrl || "").trim();
        const reverseApiKey = (chatApiKey || apiKey || "").trim();
        if (!reverseBaseUrl) throw new Error("请先配置对话 Base URL");
        if (!reverseApiKey && !isLocalApiEndpoint(reverseBaseUrl)) throw new Error("请先配置对话 API Key");

        const res = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json", ...getAuthHeaders() },
          body: JSON.stringify({
            message: "请详细描述这张图片的内容，包括主体、风格、色调、构图、细节等，生成一段完整的中文提示词，用于AI重新生成类似的图片。",
            projectId: currentProjectId,
            analyze: true,
            referenceImageUrls: [img.image_url],
            history: [],
            chatModel: actualChatModel,
            apiKey: reverseApiKey || undefined,
            baseUrl: reverseBaseUrl || undefined,
          }),
        });
        if (!res.ok) {
          let errorDetail = "反推提示词失败";
          try { const errData = await res.json(); errorDetail = errData.error || errorDetail; } catch { /* use default */ }
          throw new Error(errorDetail);
        }
        if (!res.body) throw new Error("反推提示词响应为空");
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let result = "";
        let streamBuffer = "";
        let streamError = "";
        const consumeLine = (rawLine: string) => {
          const line = rawLine.trim();
          if (!line || !line.startsWith("data: ")) return;
          const payload = line.slice(6).trim();
          if (!payload || payload === "[DONE]") return;
          try {
            const parsed = JSON.parse(payload) as { content?: string; error?: string };
            if (typeof parsed.error === "string" && parsed.error.trim()) {
              streamError = parsed.error.trim();
              return;
            }
            if (typeof parsed.content === "string") result += parsed.content;
          } catch {
            // ignore malformed chunks
          }
        };
        while (true) {
          const { done, value } = await reader.read();
          if (done) {
            streamBuffer += decoder.decode();
            break;
          }
          streamBuffer += decoder.decode(value, { stream: true });
          const lines = streamBuffer.split("\n");
          streamBuffer = lines.pop() || "";
          for (const line of lines) {
            consumeLine(line);
            if (streamError) break;
          }
          if (streamError) break;
        }
        if (!streamError && streamBuffer.trim()) {
          consumeLine(streamBuffer);
        }
        if (streamError) throw new Error(streamError);
        const promptText = result.trim();
        if (!promptText) throw new Error("反推未返回有效提示词，请重试");
        setSelectedImagePrompt(promptText);
        setSelectedImagePromptImageId(img.id);
      } catch (err) {
        alert(err instanceof Error ? err.message : "反推提示词失败");
      }
      setProcessingAction(null);
      return;
    }

    // ─── Image processing tools: use dedicated API ───
    const pendingPlaceholderIds: string[] = [];
    try {
      pushUndoHistory();

      const placeholderId = `gen-${Date.now()}`;
      const pos = findNonOverlappingPosition(
        img.canvas_x + img.canvas_width / canvasScale + 40,
        img.canvas_y,
        img.canvas_width,
        img.canvas_height
      );

      // Single action tools (removeBg, hdUpscale, cutout)
      const actionMap: Record<string, string> = {
        removeBg: "remove-bg",
        hdUpscale: "hd-upscale",
        cutout: "cutout",
      };

      setCanvasImages((prev) => [
        {
          id: placeholderId,
          image_url: "", image_key: null, project_id: currentProjectId || null,
          prompt: config.prompt, reference_images: JSON.stringify([img.image_url]),
          canvas_x: pos.x, canvas_y: pos.y, canvas_width: img.canvas_width, canvas_height: img.canvas_height,
          size: "1:1", model: imageModel, status: "pending", is_favorite: false, is_reference: false, isGenerating: true, generateStartTime: Date.now(),
          created_at: new Date().toISOString(), updated_at: null,
        },
        ...prev,
      ]);
      pendingPlaceholderIds.push(placeholderId);

      const processRes = await fetch("/api/image-process", {
        method: "POST",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify({
          action: actionMap[tool] || tool,
          imageUrl: img.image_url,
          imageKey: img.image_key,
          apiKey, baseUrl,
          projectId: currentProjectId,
          prompt: config.prompt,
        }),
      });

      let resultData = await processRes.json();

      // Poll if running
      if (resultData.status === "running" && resultData.id) {
        for (let i = 0; i < 20; i++) {
          await new Promise((r) => setTimeout(r, 3000));
          const pollRes = await fetch(`/api/image-process?taskId=${resultData.id}&apiKey=${encodeURIComponent(apiKey || (isLocalApiEndpoint(baseUrl) ? "local-model" : ""))}&baseUrl=${encodeURIComponent(baseUrl)}&action=${actionMap[tool] || tool}&projectId=${currentProjectId}${resultData.operationId ? `&operationId=${encodeURIComponent(resultData.operationId)}` : ""}`, {
            headers: { ...getAuthHeaders() },
          });
          resultData = await pollRes.json();
          if (resultData.status !== "running") break;
        }
      }

      if (resultData.status === "completed" && resultData.image_url) {
        setCanvasImages((prev) =>
          prev.map((ci) =>
            ci.id === placeholderId
              ? { ...ci, id: resultData.id || ci.id, image_url: resultData.image_url, image_key: resultData.image_key, status: "completed", isGenerating: false }
              : ci
          )
        );
      } else {
        throw new Error(resultData.error || "处理失败");
      }
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "处理失败";
      setActionToast(msg);
      setTimeout(() => setActionToast(null), 2600);
      if (pendingPlaceholderIds.length > 0) {
        const pendingSet = new Set(pendingPlaceholderIds);
        setCanvasImages((prev) => prev.filter((ci) => !(ci.isGenerating && pendingSet.has(ci.id))));
      }
    } finally {
      setProcessingAction(null);
    }
  }, [imageModel, currentProjectId, apiKey, baseUrl, chatApiKey, chatBaseUrl, actualChatModel, canvasScale, processingAction, pushUndoHistory, findNonOverlappingPosition]);

