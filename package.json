{
  "name": "projects",
  "version": "0.2.0",
  "private": true,
  "main": "electron/dist/electron/main.js",
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "lint:build": "eslint . --quiet",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm run --parallel '/^(ts-check|lint:build)$/'",
    "electron:dev": "pnpm next build && npx tsc -p electron/tsconfig.json && electron .",
    "electron:build": "bash ./scripts/electron-build.sh",
    "electron:dist": "pnpm electron-builder",
    "ppt:tools:install": "bash ./scripts/install-ppt-tools.sh",
    "desktop:icons": "node scripts/generate-desktop-icons.mjs",
    "desktop:prepare-updater": "node scripts/prepare-electron-updater-runtime.mjs",
    "desktop:release:mac": "bash ./scripts/electron-release-mac.sh",
    "desktop:release:win": "bash ./scripts/electron-release-win.sh",
    "desktop:release": "bash ./scripts/electron-release.sh",
    "desktop:verify": "node scripts/verify-desktop-release.mjs",
    "desktop:preflight": "node scripts/desktop-preflight.mjs",
    "desktop:preflight:strict": "node scripts/desktop-preflight.mjs --strict --require-version-bump",
    "desktop:postpack": "node scripts/desktop-postpack.mjs",
    "desktop:version:patch": "node scripts/desktop-version-bump.mjs --mode patch",
    "desktop:version:minor": "node scripts/desktop-version-bump.mjs --mode minor",
    "desktop:version:major": "node scripts/desktop-version-bump.mjs --mode major",
    "desktop:version:set": "node scripts/desktop-version-bump.mjs --set",
    "desktop:release:fast": "corepack pnpm run desktop:version:patch && corepack pnpm run desktop:preflight -- --ring ring1 --rollback auto && corepack pnpm run desktop:release && corepack pnpm run desktop:verify -- --platform mac && corepack pnpm run desktop:verify -- --platform win && corepack pnpm run desktop:postpack -- --ring ring1 --rollback auto"
  },
